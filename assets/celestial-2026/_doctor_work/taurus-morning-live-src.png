    border-radius: 14px !important;
    padding: 12px 14px !important;
    margin: 10px 0 !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-month-mobile-events__mobile-event-title a,
  body.tribe-events-page-template .tribe-events-calendar-month-mobile-events__mobile-event-title a {
    color: #d4af37 !important;
    font-weight: 700 !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-month-mobile-events__mobile-event-datetime,
  body.tribe-events-page-template .tribe-events-calendar-month-mobile-events__mobile-event-datetime {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  /* ============ VIEW SWITCHER: make the List/Month/Day button visible ============ */
  html body.post-type-archive-tribe_events .tribe-events .tribe-events-c-view-selector__button.tribe-events-c-view-selector__button,
