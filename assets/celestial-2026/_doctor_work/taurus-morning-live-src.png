/* Buttons */
body.post-type-archive-tribe_events .tribe-common-c-btn,
body.tribe-events .tribe-common-c-btn,
body.tribe-events-page-template .tribe-common-c-btn,
body[class*="tribe-events"] .tribe-common-c-btn,
