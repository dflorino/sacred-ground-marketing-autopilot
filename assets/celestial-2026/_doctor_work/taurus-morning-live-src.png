<body class="error404 wp-custom-logo wp-embed-responsive wp-theme-kadence theme-kadence woocommerce-no-js tribe-no-js hfeed footer-on-bottom hide-focus-outline link-style-standard content-title-style-normal content-width-normal content-style-boxed content-vertical-padding-show non-transparent-header mobile-non-transparent-header">
	<a id="sgob-rot" class="sgob-rot" href="https://shopsacredground.com/sacred-ground-observatory/" aria-label="Sacred Ground announcements — explore">
		<span class="sgob-rot__txt">Explore: today&rsquo;s Observatory</span>
	</a>
	<style>
	.sgob-rot{
		position:sticky; top:0; z-index:99999;
		display:flex; align-items:center; justify-content:center;
		min-height:72px; height:auto; box-sizing:border-box; padding:14px 20px;
		background:linear-gradient(90deg,#1a0e27 0%,#3b1a52 55%,#6b46c1 100%);
		color:#ffd27a !important; text-decoration:none;
		font-family:inherit; font-weight:700; font-size:30px;
		letter-spacing:.02em; line-height:1.2; text-align:center;
		cursor:pointer; overflow:hidden;
		transition:transform .2s ease, filter .2s ease;
		animation:sgobRotGlow 3.4s ease-in-out infinite;
	}
	body.admin-bar .sgob-rot{ top:32px; }
	.sgob-rot__txt{
		display:inline-block; max-width:94%;
		white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
		transition:opacity .45s ease;
	}
	.sgob-rot.is-fading .sgob-rot__txt{ opacity:0; }
	.sgob-rot::after{
		content:" \2192"; display:inline-block; margin-left:8px;
		flex:0 0 auto; transition:transform .2s ease;
	}
	.sgob-rot:hover{
		animation:none; transform:translateY(-1px); filter:brightness(1.12);
		text-shadow:0 0 6px rgba(255,238,187,.95), 0 0 22px rgba(243,218,148,.9);
	}
	.sgob-rot:hover::after{ transform:translateX(5px); }
	@keyframes sgobRotGlow{
		0%,100%{ text-shadow:0 0 6px rgba(255,210,122,.30); }
		50%{ text-shadow:0 0 15px rgba(255,210,122,.72); }
	}
	/* breathing room under sticky banner before logo/nav */
	body:has(#sgob-rot) .kadence-header-wrap,
	body:has(#sgob-rot) #masthead,
	body:has(#sgob-rot) header.site-header{
		padding-top:4px !important;
	}
	/* keep Kadence's sticky header from fighting the banner */
	.kadence-sticky-header.item-is-fixed{ transform:none !important; }
	@media(max-width:782px){
		body.admin-bar .sgob-rot{ top:46px; }
		.sgob-rot{ font-size:18px; min-height:60px; height:auto; padding:12px; }
	}
	@media(prefers-reduced-motion:reduce){
		.sgob-rot{ animation:none; text-shadow:0 0 10px rgba(255,210,122,.5); }
		.sgob-rot__txt{ transition:none; }
		.sgob-rot:hover{ transform:none; }
	}
	</style>
