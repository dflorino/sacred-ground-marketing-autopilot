  text-transform: uppercase !important;
  opacity: 1 !important;
  text-shadow: 0 0 8px rgba(212,175,55,.35) !important;
}
.sg-contact h6 { color: #ffffff !important; }
h6.kt-adv-heading1000_8efd10-4d { color: #ffffff !important; }

/* Accessibility fix: gold headings on light/white backgrounds */
.entry-content h2, .entry-content h4 { color: #8B6914 !important; }

.sg-info-content h4 { color: #ffffff !important; }
.sg-happenings-card h3 { color: #ffffff !important; }
.sg-contact h6 { color: #ffffff !important; display: block; font-size: 16px; }

/* Cart page: prevent header overlap on Cart Summary title */
body.woocommerce-cart #inner-wrap 


