, lifted above everything */body.post-type-archive-tribe_events .tribe-events .datepicker.datepicker-dropdown{background:#160a24 !important;border:1px solid rgba(255,198,63,.4) !important;border-radius:12px !important;padding:14px !important;box-shadow:0 12px 34px rgba(0,0,0,.6) !important;z-index:99999 !important;}.datepicker .datepicker-grid{gap:8px !important;}.datepicker .month,.datepicker .year{padding:11px 18px !important;}.datepicker td.day{padding:8px !important;}body.post-type-archive-tribe_events .tribe-events .datepicker .month,body.post-type-archive-tribe_events .tribe-events .datepicker .year,body.post-type-archive-tribe_events .tribe-events .datepicker td.day{background:#2a1840 !important;color:#f3e7c9 !important;border:1px solid rgba(255,198,63,.22) !important;text-shadow:none !important;}body.post-type-archive-tribe_events .tribe-events .datepicker .month:hover,body.post-type-archive-tribe_events .tribe-events .datepicker .year:hover,body.post-type-archive-tribe_events .tribe-events .datepicker td.day:hover{background:rgba(255,198,63,.2) !important;color:#fff !important;}body.post-type-archive-tribe_events .tribe-events .datepicker .month.active,body.post-type-archive-tribe_events .tribe-events .datepicker .month.current,body.post-type-archive-tribe_events .tribe-events .datepicker .year.active,body.post-type-archive-tribe_events .tribe-events .datepicker .day.active,body.post-type-archive-tribe_events .tribe-events .datepicker .day.current{background:#ffc63f !important;color:#1a0e27 !important;}</style><style id="wp-custom-css">
/* SACRED GROUND CSS RULE:
   Only add new CSS in the FINAL block at the very bottom.
   Page-scope whenever possible (body.page-id-XXXX).
*/

=========================================================
   SACRED GROUND — MASTER CSS V2 (FULL REPLACE)
   Fixes: TEC page not picking up styles, white/gray default showing,
          control bar + cards + typography + gold nav + gold prices
   ========================================================= */

/* ---------- GLOBAL BASE: stop white flashes ---------- */
html, body, #page, #wrapper, #content, .site, .site-content {
  background-color: #1b0f33 !important;
}

/* ---------- GLOBAL HEADER / NAV ---------- */
.site-header,
#masthead,
.site-header-wrap,
.site-header-inner,
.site-header-row,
.site-header .site-header-row-container,
.site-header .site-header-row {
  background: #2a1456 !important;
}

.site-header .main-navigation a,
.site-header .primary-navigation a,
#main-navigation a,
.header-navigation a,
.site-navigation a,
.site-header a {
  color: #d4af37 !important;
  text-decoration: none !important;
}

.site-header .main-navigation a:hover,
.site-header .primary-navigation a:hover,
#main-navigation a:hover,
.header-navigation a:hover,
.site-navigation a:hover,
.site-header a:hover {
  color: #f2d889 !important;
}

/* ---------- EVENTS PAGE: TARGET ALL TEC BODY/TEMPLATES ---------- */
/* TEC can render with different body classes depending on setup */
body.post-type-archive-tribe_events,
body.tribe-events,
body.tribe-events-page-template,
body.tribe-events-page-template-default,
body.tribe-events-page-template__template,
body.tribe_events-template-default,
body[class*="tribe-events"] {
  background: radial-gradient(1200px 800px at 50% 15%, rgba(255,255,255,0.08), rgba(0,0,0,0) 55%),
              linear-gradient(180deg, #2a1456 0%, #1b0f33 70%, #140a26 100%) !important;
}

/* Force the actual TEC wrapper backgrounds (this is what your screenshot shows failing) */
body.post-type-archive-tribe_events .tribe-common,
body.tribe-events .tribe-common,
body.tribe-events-page-template .tribe-common,
body[class*="tribe-events"] .tribe-common,
body.post-type-archive-tribe_events .tribe-events,
body.tribe-events .tribe-events,
body.tribe-events-page-template .tribe-events,
body[class*="tribe-events"] .tribe-events,
body.post-type-archive-tribe_events .tribe-events-pg-template,
body.tribe-events .tribe-events-pg-template,
body.tribe-events-page-template .tribe-events-pg-template,
body[class*="tribe-events"] .tribe-events-pg-template,
body.post-type-archive-tribe_events #tribe-events-pg-template,
body.tribe-events #tribe-events-pg-template,
body.tribe-events-page-template #tribe-events-pg-template,
body[class*="tribe-events"] #tribe-events-pg-template {
  background: transparent !important;
}

/* Center container */
body.post-type-archive-tribe_events .tribe-common-l-container,
body.tribe-events .tribe-common-l-container,
body.tribe-events-page-template .tribe-common-l-container,
body[class*="tribe-events"] .tribe-common-l-container,
body.post-type-archive-tribe_events #tribe-events,
body.tribe-events #tribe-events,
body.tribe-events-page-template #tribe-events,
body[class*="tribe-events"] #tribe-events {
  max-width: 1160px !important;
  width: min(1160px, calc(100% - 40px)) !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* ---------- TOP CONTROLS BAR ---------- */
body.post-type-archive-tribe_events .tribe-events-c-top-bar,
body.tribe-events .tribe-events-c-top-bar,
body.tribe-events-page-template .tribe-events-c-top-bar,
