    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    width: auto !important;
    height: 40px !important;
    padding: 0 16px !important;
    background: linear-gradient(180deg, #e9d27f, #d4af37) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    border-radius: 999px !important;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.30) !important;
  }
  html body.post-type-archive-tribe_events .tribe-events .tribe-events-c-view-selector__button-icon,
  html body.tribe-events-page-template .tribe-events .tribe-events-c-view-selector__button-icon {
