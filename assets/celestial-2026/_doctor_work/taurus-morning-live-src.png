.tribe-events-calendar-month__day-date {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  color: var(--sg-gold, #d4af37);
  font-weight: 600;
}

/* 5️⃣ Prevent empty days from collapsing */
