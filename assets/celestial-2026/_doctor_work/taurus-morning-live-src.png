  html body.tribe-events-page-template .tribe-common .tribe-events-c-view-selector__button-text {
    position: static !important;
    width: auto !important;
    height: auto !important;
    clip: auto !important;
    clip-path: none !important;
    overflow: visible !important;
    margin: 0 !important;
    padding: 0 !important;
    color: #1b1230 !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    white-space: nowrap !important;
  }

  /* Dropdown that opens from the view switcher */
  html body.post-type-archive-tribe_events .tribe-events-c-view-selector__content.tribe-events-c-view-selector__content,
  html body.tribe-events-page-template .tribe-events-c-view-selector__content.tribe-events-c-view-selector__content {
