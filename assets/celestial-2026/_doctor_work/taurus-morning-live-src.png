		<style id="sg-mobile-calendar-fix">

@media (max-width: 782px) {

  /* ============ MONTH GRID: undo the gold-pill button styling on day cells ============ */
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day,
  body.tribe-events-page-template .tribe-events-calendar-month__day {
    min-height: unset !important;
  }

  body.post-type-archive-tribe_events .tribe-events-calendar-month__body,
  body.tribe-events-page-template .tribe-events-calendar-month__body {
    row-gap: 8px !important;
  }

  body.post-type-archive-tribe_events .tribe-events-calendar-month__week,
  body.tribe-events-page-template .tribe-events-calendar-month__week {
    gap: 4px !important;
  }

  body.post-type-archive-tribe_events button.tribe-events-calendar-month__day-cell--mobile,
  body.tribe-events-page-template button.tribe-events-calendar-month__day-cell--mobile {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    width: 100% !important;
    min-height: 54px !important;
    height: auto !important;
    padding: 7px 0 6px !important;
    margin: 0 !important;
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(212, 175, 55, 0.22) !important;
    border-radius: 12px !important;
    box-shadow: none !important;
  }

  /* Day numbers: readable gold */
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day-cell--mobile .tribe-events-calendar-month__day-date,
  body.tribe-events-page-template .tribe-events-calendar-month__day-cell--mobile .tribe-events-calendar-month__day-date {
    color: #f2c94c !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    line-height: 1.1 !important;
    margin: 0 !important;
    text-shadow: none !important;
  }

  /* Event dot under the day number: solid gold so days with events stand out */
  body.post-type-archive-tribe_events .tribe-events-calendar-month__mobile-events-icon,
  body.tribe-events-page-template .tribe-events-calendar-month__mobile-events-icon {
    background: #d4af37 !important;
    width: 7px !important;
    height: 7px !important;
    border-radius: 50% !important;
    margin-top: 4px !important;
  }

  /* Today: gold-filled cell with dark number */
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day--current button.tribe-events-calendar-month__day-cell--mobile,
  body.tribe-events-page-template .tribe-events-calendar-month__day--current button.tribe-events-calendar-month__day-cell--mobile {
    background: linear-gradient(180deg, #e9d27f, #d4af37) !important;
    border-color: rgba(255, 255, 255, 0.35) !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day--current .tribe-events-calendar-month__day-date,
  body.tribe-events-page-template .tribe-events-calendar-month__day--current .tribe-events-calendar-month__day-date {
    color: #1b1230 !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day--current .tribe-events-calendar-month__mobile-events-icon,
  body.tribe-events-page-template .tribe-events-calendar-month__day--current .tribe-events-calendar-month__mobile-events-icon {
    background: #1b1230 !important;
  }

  /* Selected day: gold ring */
  body.post-type-archive-tribe_events button.tribe-events-calendar-month__day-cell--selected,
  body.tribe-events-page-template button.tribe-events-calendar-month__day-cell--selected {
    outline: 2px solid #d4af37 !important;
    outline-offset: -2px !important;
  }

  /* Past days: dimmed but still legible */
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day--past button.tribe-events-calendar-month__day-cell--mobile,
  body.tribe-events-page-template .tribe-events-calendar-month__day--past button.tribe-events-calendar-month__day-cell--mobile {
    background: rgba(255, 255, 255, 0.03) !important;
    border-color: rgba(255, 255, 255, 0.10) !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-month__day--past .tribe-events-calendar-month__day-date,
  body.tribe-events-page-template .tribe-events-calendar-month__day--past .tribe-events-calendar-month__day-date {
    color: rgba(255, 255, 255, 0.45) !important;
  }

  /* Weekday letters row: smaller on phone so it fits */
  body .tribe-events-view--month .tribe-events-calendar-month__header-column-title {
    font-size: 13px !important;
    letter-spacing: 0.08em !important;
  }

  /* ============ DAY DETAIL CARDS (shown when you tap a day) ============ */
  body.post-type-archive-tribe_events .tribe-events-calendar-month-mobile-events__mobile-event,
  body.tribe-events-page-template .tribe-events-calendar-month-mobile-events__mobile-event {
