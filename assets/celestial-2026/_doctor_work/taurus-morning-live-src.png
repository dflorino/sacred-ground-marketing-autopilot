/* =========================================================
   SACRED GROUND — EVENTS TOP BAR "GLASS" + GOLD DATE TAG
   Safe add-on (paste at VERY BOTTOM of Additional CSS)
   ========================================================= */

/* Brand tokens */
:root{
  --sg-gold: #d4af37;
  --sg-glass-bg: rgba(20, 12, 40, 0.55);
  --sg-glass-border: rgba(212, 175, 55, 0.22);
  --sg-glass-shadow: 0 18px 45px rgba(0,0,0,0.35);
}

/* ---------- TOP CONTROLS BAR (Search + Find Events + List/Month/Day) ---------- */
body.post-type-archive-tribe_events .tribe-events-c-top-bar,
body.post-type-archive-tribe_events .tribe-events-header__top-bar,
body.post-type-archive-tribe_events .tribe-common .tribe-common-l-container .tribe-events-c-top-bar{
  background: var(--sg-glass-bg) !important;
  border: 1px solid var(--sg-glass-border) !important;
  border-radius: 18px !important;
  box-shadow: var(--sg-glass-shadow) !important;
  backdrop-filter: blur(14px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(14px) saturate(140%) !important;
  padding: 14px 14px !important;
  overflow: hidden !important;
}

/* Remove that “white slab” feeling inside the top bar */
body.post-type-archive-tribe_events .tribe-events-c-top-bar *{
  border-color: rgba(212,175,55,0.22) !important;
}

/* Search input: darker/glassy */
body.post-type-archive-tribe_events .tribe-events-c-search__input-control input,
body.post-type-archive-tribe_events .tribe-events-c-search input[type="search"]{
  background: rgba(255,255,255,0.08) !important;
  color: rgba(255,255,255,0.92) !important;
  border: 1px solid rgba(212,175,55,0.20) !important;
  border-radius: 999px !important;
  box-shadow: none !important;
}

/* Placeholder text */
body.post-type-archive-tribe_events .tribe-events-c-search__input-control input::placeholder,
body.post-type-archive-tribe_events .tribe-events-c-search input[type="search"]::placeholder{
  color: rgba(255,255,255,0.55) !important;
}

/* "Find Events" button */
body.post-type-archive-tribe_events .tribe-events-c-search__button,
body.post-type-archive-tribe_events .tribe-events-c-search button,
body.post-type-archive-tribe_events .tribe-common .tribe-common-c-btn{
  background: linear-gradient(180deg, rgba(212,175,55,0.95), rgba(212,175,55,0.75)) !important;
  color: #1a102f !important;
  border: 1px solid rgba(255,255,255,0.25) !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 25px rgba(0,0,0,0.22) !important;
  font-weight: 600 !important;
}

/* List / Month / Day pills */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button,
