/* =========================================================
   TEC MONTH VIEW — STRUCTURE FIX (numbers visible + no gap)
   ========================================================= */

/* 1️⃣ Restore proper grid behavior for the month */
body.post-type-archive-tribe_events 
.tribe-events-calendar-month__weeks {
  display: grid !important;
  grid-template-rows: repeat(6, auto) !important;
  align-content: start !important;
  row-gap: 24px;
}

/* 2️⃣ Ensure each week row collapses naturally */
body.post-type-archive-tribe_events 
.tribe-events-calendar-month__week {
  display: grid !important;
  grid-template-columns: repeat(7, 1fr);
  min-height: unset !important;
  height: auto !important;
}

/* 3️⃣ Prevent phantom vertical spacing */
body.post-type-archive-tribe_events 
.tribe-events-calendar-month__body,
body.post-type-archive-tribe_events 
.tribe-events-calendar-month__grid {
  padding-top: 0 !important;
  margin-top: 0 !important;
  min-height: unset !important;
}

/* 4️⃣ FORCE day numbers to always render */
