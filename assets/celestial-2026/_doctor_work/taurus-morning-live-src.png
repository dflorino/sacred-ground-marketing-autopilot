<script id="sg-shop-ui-polish-js">
(function () {
  function cleanCartLabels(root) {
    var scope = root || document;
    scope.querySelectorAll('a.add_to_cart_button, a.button.product_type_simple, a.button.product_type_variable, a.product_type_variable').forEach(function (btn) {
      btn.querySelectorAll('svg title').forEach(function (t) { t.textContent = ''; });
      btn.querySelectorAll('.kadence-svg-iconset, svg').forEach(function (el) {
        el.setAttribute('aria-hidden', 'true');
        el.setAttribute('focusable', 'false');
      });
      if (!btn.getAttribute('aria-label')) {
        var card = btn.closest('li.product');
        var title = card && card.querySelector('.woocommerce-loop-product__title, .product-title, h2, h3');
        if (title && title.textContent.trim()) {
          var action = btn.classList.contains('product_type_variable') || /select options/i.test(btn.textContent)
            ? 'Select options for '
            : 'Add to cart: ';
          btn.setAttribute('aria-label', action + title.textContent.trim());
        }
      }
    });
  }

  function syncLightbox() {
    var open = !!document.querySelector('.pswp--open, .pswp.pswp--open, .pswp[aria-hidden="false"]');
    document.documentElement.classList.toggle('pswp-open', open);
    document.body.classList.toggle('pswp-open', open);
  }

  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }

  ready(function () {
    cleanCartLabels();
    syncLightbox();
    if (window.MutationObserver) {
      new MutationObserver(function (muts) {
        syncLightbox();
        for (var i = 0; i < muts.length; i++) {
          if (muts[i].addedNodes && muts[i].addedNodes.length) {
            cleanCartLabels();
            break;
          }
        }
      }).observe(document.documentElement, {
        attributes: true,
        subtree: true,
        childList: true,
        attributeFilter: ['class', 'aria-hidden']
      });
    }
    document.addEventListener('click', function () { setTimeout(syncLightbox, 50); }, true);
    document.addEventListener('keyup', function (e) {
      if (e.key === 'Escape') setTimeout(syncLightbox, 50);
    });
  });
})();
</script>
		<script>
(function(){
  function stamp(a){
    if(!a||!a.getAttribute){return;}
    var href=a.getAttribute("href"); if(!href||href.indexOf("/stripe-checkout")===-1){return;}
    try{var u=new URL(href,location.href);u.searchParams.set("mlts",Date.now().toString(36)+Math.random().toString(36).slice(2,10));a.href=u.toString();}catch(x){}
  }
  document.addEventListener("click",function(e){var a=e.target&&e.target.closest?e.target.closest("a[href*='/stripe-checkout']"):null;if(a){stamp(a);}},true);
  document.addEventListener("submit",function(e){
    var f=e.target; if(!f||!f.action){return;}
    if(String(f.action).indexOf("/stripe-checkout")===-1){return;}
    try{var u=new URL(f.action,location.href);u.searchParams.set("mlts",Date.now().toString(36)+Math.random().toString(36).slice(2,10));f.action=u.toString();}catch(x){}
  },true);
})();
</script>
