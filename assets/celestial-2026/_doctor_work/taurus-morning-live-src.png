    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-weight: 400;
    padding: 20px 20px 10px;
    margin: 0 auto;
    max-width: 800px;
}

