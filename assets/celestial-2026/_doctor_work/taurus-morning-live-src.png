/* --- 4) Gold “pill” buttons: Find Events + List/Month/Day --- */
body.post-type-archive-tribe_events .tribe-events button,
body.post-type-archive-tribe_events .tribe-events a.tribe-common-c-btn,
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-search__button,
body.post-type-archive-tribe_events .tribe-common button,
body.post-type-archive-tribe_events .tribe-common a.tribe-common-c-btn,
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-search__button {
  background: linear-gradient(180deg, #f2dd8a 0%, #d8b64f 100%) !important;
  color: #1a1433 !important;
  border: 1px solid rgba(255,255,255,0.20) !important;
  border-radius: 999px !important;
  padding: 10px 18px !important;
  font-weight: 700 !important;
  min-height: 44px !important;
}

/* View switcher pills: List / Month / Day */
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-view-selector__button,
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-view-selector__button,
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-view-selector__list-item-link,
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-view-selector__list-item-link {
  border-radius: 999px !important;
}

/* Inactive pills (dark glass) */
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-view-selector__button:not(.tribe-events-c-view-selector__button--active),
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-view-selector__button:not(.tribe-events-c-view-selector__button--active) {
  background: rgba(15, 14, 34, 0.45) !important;
  color: rgba(255,255,255,0.88) !important;
  border: 1px solid rgba(255,255,255,0.14) !important;
}

/* Active pill = gold */
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-view-selector__button--active,
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-view-selector__button--active {
  background: linear-gradient(180deg, #f2dd8a 0%, #d8b64f 100%) !important;
  color: #1a1433 !important;
  border: 1px solid rgba(255,255,255,0.22) !important;
  box-shadow: 0 10px 24px rgba(0,0,0,0.35) !important;
}

/* --- 5) Left date badge (Sun / 21) in gold --- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag .tribe-events-calendar-list__event-date-tag-datetime,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag .tribe-events-calendar-list__event-date-tag-weekday,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag .tribe-events-calendar-list__event-date-tag-daynum {
  color: #d4af37 !important;
}

/* --- 6) Prices in gold (inside event cards/list) --- */
body.post-type-archive-tribe_events .tribe-events .sg-price,
body.post-type-archive-tribe_events .tribe-events [class*="price"],
body.post-type-archive-tribe_events .tribe-events .tribe-common-b3 strong,
body.post-type-archive-tribe_events .tribe-common [class*="price"] {
  color: #d4af37 !important;
}

/* --- 7) If any random white backgrounds survive inside the top bar, nuke them --- */
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-top-bar .tribe-common-form-control-text__input,
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-top-bar .tribe-common-form-control-text__input,
body.post-type-archive-tribe_events .tribe-events .tribe-events-c-top-bar .tribe-common-c-btn-border,
body.post-type-archive-tribe_events .tribe-common .tribe-events-c-top-bar .tribe-common-c-btn-border {
  background: transparent !important;
}

/* ============================================================
   SACRED GROUND — EVENTS "TOP BAR + DATE TAG" PATCH (SAFE ADD-ON)
   Paste at the VERY BOTTOM of your Events CSS
   ============================================================ */

/* --- 0) Slightly richer / less muddy purple on events pages (subtle) --- */
body.post-type-archive-tribe_events,
body.tribe-events-page-template,
body.single-tribe_events {
  /* Richer purple glow without going black */
  background:
    radial-gradient(1200px 600px at 20% 0%,
      rgba(120, 95, 195, 0.42) 0%,
      rgba(58, 43, 109, 0.55) 45%,
      rgba(25, 16, 55, 0.95) 100%) !important;
}

/* --- 1) KILL any lingering white "bar" / container backgrounds --- */
body.post-type-archive-tribe_events .tribe-common-l-container,
body.post-type-archive-tribe_events .tribe-events,
body.post-type-archive-tribe_events #tribe-events,
body.post-type-archive-tribe_events .tribe-events-pg-template,
body.tribe-events-page-template .tribe-common-l-container,
body.tribe-events-page-template .tribe-events,
body.tribe-events-page-template #tribe-events,
body.tribe-events-page-template .tribe-events-pg-template {
  background: transparent !important;
}

/* Give a little breathing room under your NAV (since you want space back) */
body.post-type-archive-tribe_events .tribe-common-l-container,
body.tribe-events-page-template .tribe-common-l-container {
  padding-top: 18px !important; /* adjust 14–26px if you want */
}

/* --- 2) Make the TOP SEARCH BAR "BLACK GLASS" like your go-to screenshot --- */
body.post-type-archive-tribe_events .tribe-events-c-top-bar,
body.tribe-events-page-template .tribe-events-c-top-bar {
  background: rgba(10, 10, 18, 0.60) !important;
  border: 1px solid rgba(216, 189, 99, 0.22) !important;
  border-radius: 18px !important;
  backdrop-filter: blur(14px) !important;
  -webkit-backdrop-filter: blur(14px) !important;
  box-shadow: 0 18px 50px rgba(0,0,0,0.40) !important;
  padding: 14px 14px !important;
}

/* Remove the white strip inside the top bar area */
body.post-type-archive-tribe_events .tribe-events-c-top-bar * ,
body.tribe-events-page-template .tribe-events-c-top-bar * {
  background-color: transparent;
}

/* Search input glass */
body.post-type-archive-tribe_events .tribe-events-c-search__input-control,
body.tribe-events-page-template .tribe-events-c-search__input-control,
body.post-type-archive-tribe_events .tribe-events-c-search__input,
body.tribe-events-page-template .tribe-events-c-search__input {
  background: rgba(255,255,255,0.08) !important;
  color: rgba(255,255,255,0.92) !important;
  border: 1px solid rgba(255,255,255,0.16) !important;
  border-radius: 999px !important;
}

body.post-type-archive-tribe_events .tribe-events-c-search__input::placeholder,
body.tribe-events-page-template .tribe-events-c-search__input::placeholder {
  color: rgba(255,255,255,0.55) !important;
}

/* "Find Events" button = gold pill */
body.post-type-archive-tribe_events .tribe-events-c-search__button,
body.tribe-events-page-template .tribe-events-c-search__button {
  background: linear-gradient(180deg, rgba(216,189,99,1) 0%, rgba(190,160,70,1) 100%) !important;
  color: rgba(20, 15, 35, 1) !important;
  border: 1px solid rgba(255,255,255,0.25) !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 24px rgba(0,0,0,0.35) !important;
}

/* List / Month / Day pills (gold, not gray blocks) */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link,
body.tribe-events-page-template .tribe-events-c-view-selector__list-item-link {
  border-radius: 999px !important;
  padding: 10px 18px !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
  background: rgba(0,0,0,0.25) !important;
  color: rgba(255,255,255,0.82) !important;
}

/* Active view pill = gold */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item--active .tribe-events-c-view-selector__list-item-link,
body.tribe-events-page-template .tribe-events-c-view-selector__list-item--active .tribe-events-c-view-selector__list-item-link {
  background: linear-gradient(180deg, rgba(216,189,99,1) 0%, rgba(190,160,70,1) 100%) !important;
  color: rgba(20, 15, 35, 1) !important;
  border: 1px solid rgba(255,255,255,0.25) !important;
}

/* --- 3) Make the DATE/DAY feel like ONE CARD with the event (not a separate panel) --- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-row,
body.tribe-events-page-template .tribe-events-calendar-list__event-row {
  position: relative !important;
}

/* Turn the date tag into an "overlay badge" that sits ON the event card */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag {
  position: absolute !important;
  left: 18px !important;
  top: 18px !important;
  z-index: 5 !important;

  /* Remove the “separate card” look */
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* The actual badge styling */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag-datetime,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag-datetime {
  display: inline-flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;

  width: 78px !important;
  height: 78px !important;

  background: rgba(0,0,0,0.22) !important;
  border: 1px solid rgba(216,189,99,0.30) !important;
  border-radius: 14px !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
}

/* Gold weekday + day number */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag-weekday,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag-weekday,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag-daynum,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag-daynum,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag-month,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag-month {
  color: rgba(216,189,99,1) !important;
  font-weight: 700 !important;
}

/* Make room inside the event content so the badge doesn’t collide with text */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-wrapper,
body.tribe-events-page-template .tribe-events-calendar-list__event-wrapper {
  padding-left: 110px !important;
}

/* --- 4) Mobile safety so the top bar doesn’t get weird --- */
@media (max-width: 900px) {
  body.post-type-archive-tribe_events .tribe-events-c-top-bar,
  body.tribe-events-page-template .tribe-events-c-top-bar {
    padding: 12px !important;
  }

  body.post-type-archive-tribe_events .tribe-events-calendar-list__event-wrapper,
  body.tribe-events-page-template .tribe-events-calendar-list__event-wrapper {
    padding-left: 0 !important;
    padding-top: 92px !important; /* badge stacks above on small screens */
  }

  body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag,
  body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag {
    left: 16px !important;
    top: 14px !important;
  }
}

/* ============================================================
   SACRED GROUND — EVENTS “GO-TO” LOOK (SAFE ADD-ON)
   Paste at the VERY BOTTOM of your Events CSS
   ============================================================ */

/* --- Theme variables (easy tweaks) --- */
:root{
  --sg-gold: #d4af37;
  --sg-gold-soft: #e7cd7a;
  --sg-ink: rgba(12, 10, 18, .70);        /* black glass */
  --sg-ink-2: rgba(12, 10, 18, .55);      /* softer black glass */
  --sg-border: rgba(212,175,55,.28);
  --sg-purple-a: rgba(120, 95, 195, .55); /* richer purple glow */
  --sg-purple-b: rgba(58, 43, 109, .55);
  --sg-purple-c: rgba(25, 16, 55, .60);
}

/* ============================================================
   0) Page breathing room (space after main nav)
   ============================================================ */
body.post-type-archive-tribe_events .site-content,
body.tribe-events-page-template .site-content{
  padding-top: 18px !important;  /* adjust 14–26px if you want more/less */
}

/* ============================================================
   1) Richer purple background (match your go-to vibe)
   ============================================================ */
body.post-type-archive-tribe_events,
body.tribe-events-page-template,
body.post-type-archive-tribe_events .site,
body.tribe-events-page-template .site{
  background:
    radial-gradient(1200px 700px at 50% 10%, var(--sg-purple-a), transparent 60%),
    radial-gradient(1200px 900px at 50% 70%, var(--sg-purple-b), transparent 65%),
    linear-gradient(180deg, rgba(43, 24, 92, .85), rgba(24, 14, 56, .92)) !important;
}

/* ============================================================
   2) TOP TOOLBAR — kill white + make black “glass”
   ============================================================ */

/* The main Events toolbar wrapper */
body.post-type-archive-tribe_events .tribe-events-c-top-bar,
body.tribe-events-page-template .tribe-events-c-top-bar{
  background: var(--sg-ink) !important;
  border: 1px solid var(--sg-border) !important;
  border-radius: 18px !important;
  box-shadow: 0 18px 50px rgba(0,0,0,.35) !important;
  backdrop-filter: blur(14px) !important;
  -webkit-backdrop-filter: blur(14px) !important;
  padding: 14px 16px !important;
}

/* This is the piece that often stays WHITE (search row / internal container) */
body.post-type-archive-tribe_events .tribe-events-c-top-bar__search,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__actions,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__nav,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__datepicker,
body.post-type-archive-tribe_events .tribe-events-c-top-bar > *,
body.tribe-events-page-template .tribe-events-c-top-bar__search,
body.tribe-events-page-template .tribe-events-c-top-bar__actions,
body.tribe-events-page-template .tribe-events-c-top-bar__nav,
body.tribe-events-page-template .tribe-events-c-top-bar__datepicker,
body.tribe-events-page-template .tribe-events-c-top-bar > *{
  background: transparent !important;
}

/* Search input “glass” (removes the white slab look) */
body.post-type-archive-tribe_events .tribe-events-c-search__input-control,
body.tribe-events-page-template .tribe-events-c-search__input-control{
  background: var(--sg-ink-2) !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  border-radius: 999px !important;
  color: rgba(255,255,255,.88) !important;
}
body.post-type-archive-tribe_events .tribe-events-c-search__input-control::placeholder,
body.tribe-events-page-template .tribe-events-c-search__input-control::placeholder{
  color: rgba(255,255,255,.55) !important;
}

/* ============================================================
   3) “Find Events” + List / Month / Day = YELLOW PILLS
   ============================================================ */

/* Find Events button */
body.post-type-archive-tribe_events .tribe-events-c-search__button,
body.tribe-events-page-template .tribe-events-c-search__button{
  background: linear-gradient(180deg, var(--sg-gold-soft), var(--sg-gold)) !important;
  color: #1c1428 !important;
  border: 0 !important;
  border-radius: 999px !important;
  padding: 10px 16px !important;
  font-weight: 700 !important;
  box-shadow: 0 10px 24px rgba(0,0,0,.25) !important;
}

/* View switcher pills */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link,
body.tribe-events-page-template .tribe-events-c-view-selector__list-item-link{
  background: rgba(255,255,255,.06) !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  color: rgba(255,255,255,.85) !important;
  border-radius: 999px !important;
  padding: 8px 14px !important;
}

/* Active view pill becomes yellow */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item--active .tribe-events-c-view-selector__list-item-link,
body.tribe-events-page-template .tribe-events-c-view-selector__list-item--active .tribe-events-c-view-selector__list-item-link{
  background: linear-gradient(180deg, var(--sg-gold-soft), var(--sg-gold)) !important;
  color: #1c1428 !important;
  border: 0 !important;
}

/* ============================================================
   4) DATE RANGE BAR (Now–December 27) = GOLD GLASS
   ============================================================ */

body.post-type-archive-tribe_events .tribe-events-calendar-list__top-bar,
body.post-type-archive-tribe_events .tribe-events-calendar-month__header,
body.tribe-events-page-template .tribe-events-calendar-list__top-bar,
body.tribe-events-page-template .tribe-events-calendar-month__header{
  background: transparent !important;
}

/* The actual “Now – …” bar (selector varies by view; cover common ones) */
body.post-type-archive-tribe_events .tribe-events-calendar-list__nav,
body.post-type-archive-tribe_events .tribe-events-c-nav__list,
body.post-type-archive-tribe_events .tribe-events-c-nav__next,
body.post-type-archive-tribe_events .tribe-events-c-nav__prev,
body.tribe-events-page-template .tribe-events-calendar-list__nav,
body.tribe-events-page-template .tribe-events-c-nav__list,
body.tribe-events-page-template .tribe-events-c-nav__next,
body.tribe-events-page-template .tribe-events-c-nav__prev{
  color: rgba(255,255,255,.9) !important;
}

/* the big gold “Now – …” control */
body.post-type-archive-tribe_events .tribe-events-c-nav__list-item,
body.post-type-archive-tribe_events .tribe-events-c-nav__list-item a,
body.post-type-archive-tribe_events .tribe-events-c-nav__list-item button,
body.tribe-events-page-template .tribe-events-c-nav__list-item,
body.tribe-events-page-template .tribe-events-c-nav__list-item a,
body.tribe-events-page-template .tribe-events-c-nav__list-item button{
  background: linear-gradient(180deg, rgba(231,205,122,.95), rgba(212,175,55,.95)) !important;
  border: 0 !important;
  border-radius: 14px !important;
  color: #1c1428 !important;
  font-weight: 800 !important;
}

/* ============================================================
   5) LIST VIEW — FIX “two cards” (date badge becomes part of card)
   ============================================================ */

/* Make the row behave like ONE card container */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-row,
body.tribe-events-page-template .tribe-events-calendar-list__event-row{
  position: relative !important;
  display: block !important;
}

/* The event card itself */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-wrapper,
body.tribe-events-page-template .tribe-events-calendar-list__event-wrapper{
  position: relative !important;
  background: rgba(255,255,255,.08) !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  border-radius: 18px !important;
  box-shadow: 0 18px 44px rgba(0,0,0,.28) !important;
  overflow: hidden !important;
  padding-left: 96px !important; /* makes room for the embedded date badge */
}

/* Hide the extra “panel” feeling from the date column */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag{
  position: absolute !important;
  left: 18px !important;
  top: 18px !important;
  margin: 0 !important;
  width: 64px !important;
  height: 64px !important;
  border-radius: 14px !important;
  background: rgba(12,10,18,.35) !important;
  border: 1px solid rgba(212,175,55,.25) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  z-index: 3 !important;
}

/* Day + date in GOLD */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag * ,
body.tribe-events-page-template .tribe-events-calendar-list__event-date-tag *{
  color: var(--sg-gold) !important;
  font-weight: 800 !important;
}

/* Price gold (if present in list cards) */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-cost,
body.tribe-events-page-template .tribe-events-calendar-list__event-cost{
  color: var(--sg-gold) !important;
  font-weight: 800 !important;
}

/* ============================================================
   6) MONTH VIEW — make events gold + grid softer
   ============================================================ */

/* Month grid lines softened */
body.post-type-archive-tribe_events .tribe-events-calendar-month__day,
body.post-type-archive-tribe_events .tribe-events-calendar-month__week,
body.tribe-events-page-template .tribe-events-calendar-month__day,
body.tribe-events-page-template .tribe-events-calendar-month__week{
  border-color: rgba(255,255,255,.10) !important;
}

/* Month view event titles + time = GOLD */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title a,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-datetime,
body.tribe-events-page-template .tribe-events-calendar-month__calendar-event-title,
body.tribe-events-page-template .tribe-events-calendar-month__calendar-event-title a,
body.tribe-events-page-template .tribe-events-calendar-month__calendar-event-datetime{
  color: var(--sg-gold) !important;
  font-weight: 700 !important;
}

/* Make “more events” links gold too */
body.post-type-archive-tribe_events .tribe-events-calendar-month__more-link,
body.tribe-events-page-template .tribe-events-calendar-month__more-link{
  color: var(--sg-gold) !important;
}

/* ============================================================
   7) LAST RESORT: if any WHITE background still leaks, kill it
   (safe because it’s scoped only to Events pages)
   ============================================================ */
body.post-type-archive-tribe_events .tribe-common,
body.post-type-archive-tribe_events #tribe-events,
body.tribe-events-page-template .tribe-common,
body.tribe-events-page-template #tribe-events{
  background: transparent !important;
}

/* =================================================================
   SACRED GROUND — EVENTS CALENDAR (CLEAN OVERRIDE)
   Version: 1.6
   Purpose:
   - Kill white flash/white bar across views
   - Keep Find/List/Month/Day pills yellow (all states)
   - Make List view a SINGLE event card (no “date card + event card”)
   - Richer purple to match go-to screenshot
   - Add breathing room under nav
   ================================================================= */

/* ---------- Theme variables ---------- */
:root{
  --sg-gold: #d4af37;
  --sg-gold-soft: #e7cf7a;
  --sg-ink: rgba(10, 8, 18, .72);
  --sg-ink-2: rgba(10, 8, 18, .55);

  /* richer purple match */
  --sg-purple-1: rgba(84, 58, 140, .92);
  --sg-purple-2: rgba(52, 32, 102, .92);
  --sg-purple-3: rgba(28, 16, 62, .92);

  --sg-card: rgba(255,255,255,.10);
  --sg-card-border: rgba(255,255,255,.16);
  --sg-glow: 0 18px 50px rgba(0,0,0,.45);
}

/* =================================================================
   0) KILL THE WHITE FLASH / WHITE BAR (all views)
   ================================================================= */
html,
body,
#page,
.site,
.site-content,
#content,
.content-area,
.site-main{
  background-color: transparent !important;
}

body.post-type-archive-tribe_events,
body.tribe-events-page-template,
body.single-tribe_events{
  background:
    radial-gradient(1200px 700px at 50% 220px, rgba(120,95,195,.55), rgba(0,0,0,0) 55%),
    linear-gradient(180deg, var(--sg-purple-1) 0%, var(--sg-purple-2) 45%, var(--sg-purple-3) 100%) !important;
}

/* TEC containers that like to repaint white */
body.post-type-archive-tribe_events .tribe-common,
body.post-type-archive-tribe_events .tribe-events,
body.post-type-archive-tribe_events .tribe-common-l-container,
body.post-type-archive-tribe_events .tribe-events-l-container,
body.post-type-archive-tribe_events .tribe-events-pg-template,
body.post-type-archive-tribe_events .entry-content,
body.post-type-archive-tribe_events .content-wrap{
  background: transparent !important;
}

/* Breathing room under the nav */
body.post-type-archive-tribe_events .site-main{
  padding-top: 22px !important;
}

/* =================================================================
   1) TOP SEARCH BAR — BLACK GLASS (no white)
   ================================================================= */
body.post-type-archive-tribe_events .tribe-events-c-top-bar,
body.post-type-archive-tribe_events .tribe-events-c-search,
body.post-type-archive-tribe_events .tribe-events-c-view-selector{
  background: var(--sg-ink) !important;
  border: 1px solid rgba(255,255,255,.14) !important;
  border-radius: 18px !important;
  box-shadow: var(--sg-glow) !important;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

/* If any white “panel” is still wrapping the search row */
body.post-type-archive-tribe_events .tribe-events-c-search__input-group,
body.post-type-archive-tribe_events .tribe-events-c-search__input-control,
body.post-type-archive-tribe_events .tribe-common-form-control-text__input{
  background: rgba(255,255,255,.08) !important;
  color: rgba(255,255,255,.92) !important;
  border: 1px solid rgba(255,255,255,.12) !important;
}

/* =================================================================
   2) PILLS — FORCE YELLOW (ALL STATES)
   Find Events + List/Month/Day + active/hover/focus
   ================================================================= */

/* Find Events button */
body.post-type-archive-tribe_events .tribe-events-c-search__button,
body.post-type-archive-tribe_events .tribe-common-c-btn,
body.post-type-archive-tribe_events .tribe-common-c-btn:visited{
  background: var(--sg-gold) !important;
  color: #1a1410 !important;
  border: 1px solid rgba(255,255,255,.18) !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 26px rgba(0,0,0,.30) !important;
}

/* View switcher buttons (List / Month / Day) */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button:visited,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button:hover,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button:focus{
  background: var(--sg-gold) !important;
  color: #1a1410 !important;
  border: 1px solid rgba(255,255,255,.18) !important;
  border-radius: 999px !important;
  box-shadow: 0 10px 26px rgba(0,0,0,.26) !important;
}

/* Active view button (TEC uses aria-selected + active states) */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button[aria-selected="true"],
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button.tribe-events-c-view-selector__button--active{
  background: var(--sg-gold) !important;
  color: #1a1410 !important;
  border-color: rgba(255,255,255,.26) !important;
}

/* Kill the “dark pill” override TEC sometimes applies */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__button .tribe-common-c-svgicon{
  color: #1a1410 !important;
}

/* =================================================================
   3) DATE RANGE BAR (Now – Dec 27) — GOLD GLASS
   ================================================================= */
body.post-type-archive-tribe_events .tribe-events-calendar-list__month-separator,
body.post-type-archive-tribe_events .tribe-events-calendar-list__month-separator-text,
body.post-type-archive-tribe_events .tribe-events-calendar-list__month-separator .tribe-events-calendar-list__month-separator-text{
  color: #1a1410 !important;
}

body.post-type-archive-tribe_events .tribe-events-c-nav__list,
body.post-type-archive-tribe_events .tribe-events-calendar-list__month-separator,
body.post-type-archive-tribe_events .tribe-events-calendar-list__month-separator-text{
  background: transparent !important;
}

/* the long gold “range” pill */
body.post-type-archive-tribe_events .tribe-events-c-nav__next,
body.post-type-archive-tribe_events .tribe-events-c-nav__prev{
  background: rgba(255,255,255,.06) !important;
}

/* TEC date range chip */
body.post-type-archive-tribe_events .tribe-events-c-top-bar__datepicker-button,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__datepicker-button:visited{
  background: var(--sg-gold) !important;
  color: #1a1410 !important;
  border-radius: 999px !important;
  border: 1px solid rgba(255,255,255,.18) !important;
}

/* =================================================================
   4) LIST VIEW — MAKE IT ONE CARD (NO “DATE CARD + EVENT CARD”)
   ================================================================= */

/* The full row becomes the ONE card */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-row{
  display: flex !important;
  align-items: stretch !important;
  gap: 18px !important;
  background: var(--sg-card) !important;
  border: 1px solid var(--sg-card-border) !important;
  border-radius: 18px !important;
  box-shadow: var(--sg-glow) !important;
  padding: 18px !important;
  margin: 18px 0 !important;
  overflow: hidden !important;
}

/* Date tag is NOT a separate “card” anymore */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag{
  flex: 0 0 92px !important;
  margin: 0 !important;
  background: rgba(0,0,0,.18) !important;
  border: 1px solid rgba(212,175,55,.28) !important;
  border-radius: 14px !important;
  box-shadow: none !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* Remove any extra wrapper backgrounds that were making “two boxes” */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-wrapper,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event{
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* Keep the main event content flexible */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-details{
  flex: 1 1 auto !important;
  min-width: 0 !important;
}

/* Ensure the featured image never forces overlap */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-featured-image-wrapper,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-featured-image{
  flex: 0 0 280px !important;
  max-width: 280px !important;
  border-radius: 14px !important;
  overflow: hidden !important;
}
@media (max-width: 980px){
  body.post-type-archive-tribe_events .tribe-events-calendar-list__event-row{
    flex-direction: column !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-list__event-featured-image-wrapper,
  body.post-type-archive-tribe_events .tribe-events-calendar-list__event-featured-image{
    max-width: 100% !important;
    flex: 1 1 auto !important;
  }
  body.post-type-archive-tribe_events .tribe-events-calendar-list__event-date-tag{
    flex: 0 0 auto !important;
    width: 92px !important;
  }
}

/* Titles + price in gold */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-title a{
  color: var(--sg-gold) !important;
}
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-cost{
  color: var(--sg-gold) !important;
  font-weight: 700 !important;
}

/* =================================================================
   5) MONTH VIEW — EVENTS IN GOLD
   ================================================================= */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title a,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-datetime{
  color: var(--sg-gold) !important;
}

body.post-type-archive-tribe_events .tribe-events-calendar-month__multiday-event-bar-inner,
body.post-type-archive-tribe_events .tribe-events-calendar-month__mobile-events-icon{
  background: rgba(212,175,55,.20) !important;
  border: 1px solid rgba(212,175,55,.35) !important;
}

/* Month grid should not go white */
body.post-type-archive-tribe_events .tribe-events-calendar-month,
body.post-type-archive-tribe_events .tribe-events-calendar-month__body,
body.post-type-archive-tribe_events .tribe-events-calendar-month__grid{
  background: transparent !important;
}

/* =================================================================
   6) FINAL “WHITE KILL SWITCH” (last resort, still safe)
   ================================================================= */
body.post-type-archive-tribe_events *{
  /* prevents surprise white borders from showing on transitions */
  border-color: rgba(255,255,255,.14);
}

/* =========================================================
   SACRED GROUND — EVENTS FINAL POLISH PATCH
   Paste at VERY BOTTOM of Events CSS
   ========================================================= */

/* ---------- 1) Kill the white/grey wrapper + stop white flash ---------- */
html, body,
body.post-type-archive-tribe_events,
body.tribe-events-page-template,
body.single-tribe_events {
  background: #1b0f3a !important; /* fallback so nothing flashes white */
}

body.post-type-archive-tribe_events .site,
body.post-type-archive-tribe_events #page,
body.post-type-archive-tribe_events #content,
body.post-type-archive-tribe_events .content-area,
body.post-type-archive-tribe_events .site-content,
body.post-type-archive-tribe_events .tribe-common,
body.post-type-archive-tribe_events .tribe-common-l-container,
body.post-type-archive-tribe_events .tribe-events,
body.post-type-archive-tribe_events #tribe-events,
body.tribe-events-page-template .tribe-common-l-container {
  background: transparent !important;
}

/* This is the usual culprit for the grey/white “bar” behind the top controls */
body.post-type-archive-tribe_events .tribe-events-c-top-bar,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__content,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__actions,
body.post-type-archive-tribe_events .tribe-events-c-top-bar__filters {
  background: transparent !important;
  box-shadow: none !important;
}

/* ---------- 2) Force the TOP CONTROLS ROW to black glass ---------- */
body.post-type-archive-tribe_events .tribe-events-c-top-bar {
  border-radius: 18px !important;
  padding: 12px 12px !important;
  background: rgba(0, 0, 0, 0.55) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  backdrop-filter: blur(16px) !important;
  border: 1px solid rgba(212, 175, 55, 0.22) !important;
  box-shadow: 0 18px 50px rgba(0,0,0,0.45) !important;
}

/* If the grey is coming from an inner wrapper, this clamps it */
body.post-type-archive-tribe_events .tribe-events-c-top-bar * {
  background-color: transparent;
}

/* ---------- 3) Pills: Find Events + List/Month/Day ALWAYS yellow ---------- */
body.post-type-archive-tribe_events .tribe-common-c-btn,
body.post-type-archive-tribe_events .tribe-common-c-btn:visited,
body.post-type-archive-tribe_events .tribe-events-c-search__button,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link:visited {
  background: #d4af37 !important;
  color: #1a101b !important;
  border: 0 !important;
  box-shadow: 0 10px 22px rgba(0,0,0,0.30) !important;
  border-radius: 999px !important;
  font-weight: 700 !important;
}

body.post-type-archive-tribe_events .tribe-common-c-btn:hover,
body.post-type-archive-tribe_events .tribe-events-c-search__button:hover,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link:hover,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link:focus {
  background: #e2c55b !important;
  color: #110a12 !important;
}

/* Active pill (some themes swap in different classes) */
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item--active .tribe-events-c-view-selector__list-item-link,
body.post-type-archive-tribe_events .tribe-events-c-view-selector__list-item-link[aria-current="page"] {
  background: #d4af37 !important;
  color: #1a101b !important;
}

/* ---------- 4) Give breathing room under NAV (but not huge) ---------- */
body.post-type-archive-tribe_events .tribe-common-l-container {
  padding-top: 18px !important;
}

/* ---------- 5) List card text: bump ~1pt (1px) ---------- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-title-link,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-description,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-datetime,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-venue,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-cost {
  font-size: calc(100% + 1px) !important;
}

/* ---------- 6) Month view: dates + event titles in GOLD ---------- */
body.post-type-archive-tribe_events .tribe-events-calendar-month__day-date,
body.post-type-archive-tribe_events .tribe-events-calendar-month__day-date-link,
body.post-type-archive-tribe_events .tribe-events-calendar-month__day-number {
  color: #d4af37 !important;
  font-weight: 800 !important;
}

body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title-link,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title-link:visited {
  color: #d4af37 !important;
  font-weight: 700 !important;
}

body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title-link:hover {
  color: #e2c55b !important;
}

/* ---------- 7) Safety: remove any random white borders left over ---------- */
body.post-type-archive-tribe_events .tribe-common * {
  border-left-color: transparent !important;
  border-right-color: transparent !important;
}

/* =========================================================
   MONTH VIEW — HOVER TEXT IN GOLD
   ========================================================= */

/* Event title hover */
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event-title-link:hover,
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event-title-link:focus {
  color: #d4af37 !important;
  text-decoration: none !important;
}

/* Hovered day number (some themes dim this on hover) */
body.post-type-archive-tribe_events
.tribe-events-calendar-month__day:hover
.tribe-events-calendar-month__day-number {
  color: #d4af37 !important;
}

/* Hovered multi-day / stacked events */
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event:hover
.tribe-events-calendar-month__calendar-event-title-link {
  color: #d4af37 !important;
}

/* Tooltip / popover titles (when hovering events) */
body.post-type-archive-tribe_events
.tribe-events-tooltip__title,
body.post-type-archive-tribe_events
.tribe-events-tooltip__title a {
  color: #d4af37 !important;
}

/* =========================================
   MONTH VIEW — hover tooltip / popover text = GOLD
   ========================================= */

/* Tooltip container text */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-tooltip,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-popover,
body.tribe-events-page-template .tribe-events-calendar-month__calendar-event-tooltip,
body.tribe-events-page-template .tribe-events-calendar-month__calendar-event-popover{
  color: #d4af37 !important;
}

/* Tooltip + popover title */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-tooltip-title,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-popover-title,
body.post-type-archive-tribe_events .tribe-events-tooltip__title,
body.post-type-archive-tribe_events .tribe-events-popover__title{
  color: #d4af37 !important;
}

/* Tooltip + popover body text (this is usually what stays black) */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-tooltip * ,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-popover * ,
body.post-type-archive-tribe_events .tribe-events-tooltip * ,
body.post-type-archive-tribe_events .tribe-events-popover * {
  color: #d4af37 !important;
}

/* And any links inside the hover */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-tooltip a,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-popover a,
body.post-type-archive-tribe_events .tribe-events-tooltip a,
body.post-type-archive-tribe_events .tribe-events-popover a{
  color: #d4af37 !important;
}

/* LIST VIEW — hide the address line under "Sacred Ground" */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-venue address,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-venue .tribe-events-calendar-list__event-venue-address,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-venue .tribe-venue-location,
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-venue .tribe-address {
  display: none !important;
}

/* ======================================================
   SACRED GROUND — READABILITY BOOST (SAFE)
   Increases text size across List / Month / Day views
   ====================================================== */

/* ---- EVENT TITLES (all views) ---- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-title,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title,
body.post-type-archive-tribe_events .tribe-events-calendar-day__event-title,
body.single-tribe_events .tribe-events-single-event-title {
  font-size: 1.25rem !important; /* ~1.4x */
  line-height: 1.35 !important;
}

/* ---- EVENT META (date / time) ---- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-datetime,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-datetime,
body.post-type-archive-tribe_events .tribe-events-calendar-day__event-datetime {
  font-size: 1.05rem !important;
  line-height: 1.4 !important;
}

/* ---- EVENT DESCRIPTION (List & Day) ---- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-description,
body.post-type-archive-tribe_events .tribe-events-calendar-day__event-description {
  font-size: 1.05rem !important;
  line-height: 1.6 !important;
}

/* ---- PRICE / SMALL CALLOUTS ---- */
body.post-type-archive-tribe_events .tribe-events-calendar-list__event-cost,
body.post-type-archive-tribe_events .tribe-events-calendar-day__event-cost {
  font-size: 1.05rem !important;
  font-weight: 600;
}

/* ---- MONTH VIEW EVENT TEXT ---- */
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title,
body.post-type-archive-tribe_events .tribe-events-calendar-month__calendar-event-title a {
  font-size: 0.95rem !important; /* Month grid must stay tighter */
  line-height: 1.3 !important;
}

/* ---- MONTH VIEW TOOLTIP / HOVER ---- */
body.post-type-archive-tribe_events .tribe-events-tooltip,
body.post-type-archive-tribe_events .tribe-events-tooltip__title,
body.post-type-archive-tribe_events .tribe-events-tooltip__body {
  font-size: 1rem !important;
  line-height: 1.45 !important;
}

/* =========================================================
   READABILITY BOOST — EVENTS (SAFE + RESPONSIVE)
   Desktop: larger
   Mobile: slightly larger than desktop
   ========================================================= */

/* ---------- DESKTOP DEFAULT (base bump) ---------- */
body.post-type-archive-tribe_events .tribe-events,
body.single-tribe_events {

  /* Event titles */
  --sg-title-size: 1.18rem;

  /* Meta / description text */
  --sg-body-size: 1.05rem;

  /* Month view text */
  --sg-month-size: 0.95rem;
}

/* Apply sizes */
body.post-type-archive-tribe_events
.tribe-events-event-title,
body.single-tribe_events
.tribe-events-event-title {
  font-size: var(--sg-title-size) !important;
  line-height: 1.35;
}

body.post-type-archive-tribe_events
.tribe-events-event-meta,
body.post-type-archive-tribe_events
.tribe-events-event-description,
body.single-tribe_events
.tribe-events-content {
  font-size: var(--sg-body-size) !important;
  line-height: 1.55;
}

/* Month view event text */
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event-title,
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event-datetime {
  font-size: var(--sg-month-size) !important;
  line-height: 1.35;
}

/* ---------- MOBILE (BIGGER than desktop) ---------- */
@media (max-width: 768px) {

  body.post-type-archive-tribe_events .tribe-events,
  body.single-tribe_events {

    --sg-title-size: 1.28rem;
    --sg-body-size: 1.15rem;
    --sg-month-size: 1.05rem;
  }

}

/* =========================================================
   READABILITY BOOST — EVENTS (LARGER FINAL PASS)
   Desktop: clearly larger
   Mobile: largest
   ========================================================= */

/* ---------- DESKTOP DEFAULT ---------- */
body.post-type-archive-tribe_events .tribe-events,
body.single-tribe_events {

  /* Event titles */
  --sg-title-size: 1.30rem;

  /* Meta / description text */
  --sg-body-size: 1.15rem;

  /* Month view text */
  --sg-month-size: 1.05rem;
}

/* Apply sizes */
body.post-type-archive-tribe_events
.tribe-events-event-title,
body.single-tribe_events
.tribe-events-event-title {
  font-size: var(--sg-title-size) !important;
  line-height: 1.4;
}

body.post-type-archive-tribe_events
.tribe-events-event-meta,
body.post-type-archive-tribe_events
.tribe-events-event-description,
body.single-tribe_events
.tribe-events-content {
  font-size: var(--sg-body-size) !important;
  line-height: 1.6;
}

/* Month view event text */
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event-title,
body.post-type-archive-tribe_events
.tribe-events-calendar-month__calendar-event-datetime {
  font-size: var(--sg-month-size) !important;
  line-height: 1.4;
}

/* ---------- MOBILE (LARGEST) ---------- */
@media (max-width: 768px) {

  body.post-type-archive-tribe_events .tribe-events,
  body.single-tribe_events {

    --sg-title-size: 1.42rem;
    --sg-body-size: 1.25rem;
    --sg-month-size: 1.15rem;
  }

}

/* =========================================================
   LIST VIEW — MAKE IT OBVIOUSLY BIGGER + BOLDER
