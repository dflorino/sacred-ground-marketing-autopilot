		if ( ! slides || slides.length < 2 ) { return; } // nothing to rotate
		var a   = document.getElementById('sgob-rot');
		var txt = a ? a.querySelector('.sgob-rot__txt') : null;
		if ( ! a || ! txt ) { return; }
		var i = 0;
		setInterval(function(){
			i = ( i + 1 ) % slides.length;
			a.classList.add('is-fading');
			setTimeout(function(){
				txt.innerHTML = slides[i].text;
