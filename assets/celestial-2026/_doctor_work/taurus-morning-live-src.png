}

/* SACRED GROUND - FORBES STYLE BADGES (Minimal & Classy) */

/* Star ratings - subtle gold */
.sg-stars {
    color: #d4af37;
    font-size: 14px;
    margin-left: 8px;
    opacity: 0.9;
}

/* Forbes-style badge */
.sg-forbes-badge {
    background: linear-gradient(135deg, #1a0e27, #2d1b4e);
    color: #d4af37;
    padding: 10px 24px;
    border-radius: 6px;
    text-align: center;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
    border: 1px solid rgba(212, 175, 55, 0.3);
}

/* Elegant message (italicized, understated) */
.sg-message {
    margin-top: 16px;
    padding: 12px 20px;
    background: rgba(212, 175, 55, 0.05);
    border-left: 2px solid #d4af37;
    border-radius: 4px;
    font-size: 13px;
    color: #666;
    font-style: italic;
}

/* Ensure elements don't break mobile */
@media (max-width: 768px) {
    .sg-forbes-badge {
        font-size: 12px;
        padding: 8px 16px;
    }
    
    .sg-message {
        font-size: 12px;
        padding: 10px 16px;
    }
}
/* Make event titles clearly clickable */
.tribe-events-calendar-list__event-title a,
.tribe-events-calendar-list__event-title,
.tribe-common--breakpoint-medium .tribe-events-calendar-list__event-title a {
    color: #d4af37 !important; /* Sacred Ground gold */
    font-weight: 600;
    transition: all 0.25s ease;
    cursor: pointer;
}

/* Hover effect = gentle invitation */
.tribe-events-calendar-list__event-title a:hover {
    text-shadow: 0 0 8px rgba(212, 175, 55, 0.45);
    text-decoration: none;
}
/* Subtle "this is how to book" cue */
.tribe-events-calendar-list__event-title::after {
    content: "Click to view availability & book";
    display: block;
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(212, 175, 55, 0.75);
    margin-top: 4px;
}

/* =========================================
   TEC — Search field UX fixes
   - stop magnifier from covering text
   - show a clear (X) if TEC has one
   - also enable native clear if input is type=search
   ========================================= */

/* 1) Make room so the magnifying glass never overlaps text */
.tribe-events .tribe-events-c-search__input-control,
.tribe-events .tribe-events-c-search input,
.tribe-events input.tribe-events-c-search__input-control {
  padding-left: 44px !important;  /* key fix */
  background-position: 16px center !important;
}

/* 2) If TEC renders a search icon element inside the input wrapper,
      make sure it sits left and doesn't block clicks/text */
.tribe-events .tribe-events-c-search__input-group,
.tribe-events .tribe-events-c-search__input {
  position: relative !important;
}

.tribe-events .tribe-events-c-search__input-group .tribe-common-c-svgicon,
.tribe-events .tribe-events-c-search__input .tribe-common-c-svgicon {
  position: absolute !important;
  left: 16px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  pointer-events: none !important;
  opacity: .85 !important;
}

/* 3) If TEC has its own clear button/icon, unhide it + place it on the right */
.tribe-events .tribe-events-c-search__input-control-icon--clear,
.tribe-events .tribe-events-c-search__clear-button,
.tribe-events button[class*="search__clear"],
.tribe-events button[class*="search-clear"] {
  display: inline-flex !important;
  visibility: visible !important;
  opacity: 1 !important;
}

.tribe-events .tribe-events-c-search__input-group button,
.tribe-events .tribe-events-c-search__input button {
  position: absolute !important;
  right: 12px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  z-index: 5 !important;
}

/* 4) ALSO enable the native browser clear X *if* the field is type=search */
.tribe-events input[type="search"]::-webkit-search-cancel-button {
  -webkit-appearance: searchfield-cancel-button !important;
  appearance: searchfield-cancel-button !important;
  cursor: pointer;
}

/* ==========================================
   TEC — SEARCH CLEAR (CUSTOM X INSIDE INPUT)
   ========================================== */

.tribe-events .tribe-events-c-search {
  position: relative;
}

/* Make room for the X */
.tribe-events .tribe-events-c-search__input-control {
  padding-right: 44px !important;
}

/* Our custom clear button */
.tribe-events .sg-search-clear {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 16px;
  color: rgba(212,175,55,.85);
  cursor: pointer;
  display: none;
  z-index: 5;
}

.tribe-events .sg-search-clear:hover {
  color: #d4af37;
}

document.addEventListener('DOMContentLoaded', function () {
  const searchWrap = document.querySelector('.tribe-events-c-search');
  if (!searchWrap) return;

  const input = searchWrap.querySelector('input[type="search"]');
  if (!input) return;

  // Create clear button
  const clear = document.createElement('span');
  clear.className = 'sg-search-clear';
  clear.innerHTML = '✕';
  searchWrap.appendChild(clear);

  // Show/hide X
  input.addEventListener('input', () => {
    clear.style.display = input.value.length ? 'block' : 'none';
  });

  // Clear behavior
  clear.addEventListener('click', () => {
    input.value = '';
    input.dispatchEvent(new Event('input'));
    input.dispatchEvent(new Event('change'));
    clear.style.display = 'none';
  });
});

/* ==========================================
   TEC — FIX DEAD "VIEW ALL EVENTS" LINK
   ========================================== */

.tribe-events .tribe-events-c-search,
.tribe-events .tribe-events-c-events-bar {
  pointer-events: auto !important;
}

.tribe-events a {
  pointer-events: auto !important;
  position: relative;
  z-index: 10;
}

/* =========================================================
   SACRED GROUND — TEC TOP CONTROLS (FINAL, SINGLE SOURCE)
   Restores: slim black box + cosmic veil + title + pills + small date pill
   Also fixes: month label color, search icon overlap
   Paste at VERY BOTTOM of Additional CSS
   ========================================================= */

/* ---------- 0) Make sure the "big rounded black box" is the cosmic veil card ---------- */
.tribe-events .tribe-events-c-events-bar,
.tribe-events .tribe-events-header__events-bar {
  background: linear-gradient(180deg, rgba(26,14,39,0.78), rgba(45,27,78,0.68)) !important;
  border: 1px solid rgba(212,175,55,0.18) !important;
  border-radius: 18px !important;
  box-shadow: 0 10px 30px rgba(0,0,0,0.35) !important;

  /* HEIGHT CONTROL (keeps it tight) */
  padding: 14px 18px 12px !important;
  margin-bottom: 14px !important;
}

/* Remove harsh inner panels so it feels like ONE clean card */
.tribe-events .tribe-events-c-events-bar__views,
.tribe-events .tribe-events-c-events-bar__search,
.tribe-events .tribe-events-c-top-bar {
  background: transparent !important;
  box-shadow: none !important;
}

/* ---------- 1) Kill TEC’s default headline/title so it stops reappearing ---------- */
.tribe-events .tribe-events-header__title,
.tribe-events .tribe-events-header__title-text,
.tribe-events .tribe-events-c-top-bar__title {
  display: none !important;
}

/* ---------- 2) ONE title (single source of truth) ---------- */
.tribe-events .tribe-events-c-top-bar::before {
  content: "✨ A Calendar of Sacred Experiences ✨" !important;
  display: block !important;
  width: 100% !important;
  text-align: center !important;
  margin: 0 0 10px 0 !important;
  letter-spacing: .16em !important;
  text-transform: uppercase !important;
  font-size: 16px !important; /* +2 points */
  line-height: 1.2 !important;
  color: #d4af37 !important;
}

/* ---------- 3) Tighten spacing between the search row and date row ---------- */
.tribe-events .tribe-events-c-top-bar {
  padding: 6px 10px 6px !important;
}

.tribe-events .tribe-events-c-top-bar__nav,
.tribe-events .tribe-events-c-top-bar__datepicker {
  margin-top: 6px !important;
  margin-bottom: 4px !important; /* tighter bottom */
}

/* ---------- 4) Search input: FIX magnifier overlap + keep it pretty ---------- */
.tribe-events .tribe-events-c-search {
  position: relative !important;
}

.tribe-events .tribe-events-c-search__input-control,
.tribe-events input[type="search"] {
  height: 40px !important;
  border-radius: 999px !important;
  background: rgba(107,70,193,0.20) !important;
  border: 1px solid rgba(212,175,55,0.20) !important;
  color: #e2e8f0 !important;

  /* THIS fixes the magnifier covering letters */
  padding-left: 44px !important;
  padding-right: 44px !important;
}

.tribe-events .tribe-events-c-search__input-control::placeholder,
.tribe-events input[type="search"]::placeholder {
  color: rgba(226,232,240,0.65) !important;
}

/* Push TEC’s magnifier into the left padding zone */
.tribe-events .tribe-events-c-search__input-control-icon,
.tribe-events .tribe-events-c-search__input-control-icon-svg,
.tribe-events .tribe-events-c-search__input-control-icon-wrapper {
  left: 16px !important;
}

/* ---------- 5) Remove Find Events button (Enter still searches) ---------- */
.tribe-events .tribe-events-c-search__button {
  display: none !important;
}

/* ---------- 6) View toggle pills (List / Month / Day) ---------- */
.tribe-events .tribe-events-c-view-selector__button {
  border-radius: 999px !important;
  padding: 8px 14px !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  background: rgba(212,175,55,0.10) !important;
  border: 1px solid rgba(212,175,55,0.22) !important;
  color: #d4af37 !important;
}

.tribe-events .tribe-events-c-view-selector__button:hover {
  background: rgba(212,175,55,0.18) !important;
}

/* ---------- 7) Date pill ("Now - …") small + clean ---------- */
.tribe-events .tribe-events-c-top-bar__datepicker-button,
.tribe-events button.tribe-events-c-top-bar__datepicker-button {
  padding: 8px 14px !important;
  height: 34px !important;
  min-height: 34px !important;
  border-radius: 18px !important;
  font-size: 15px !important;
  line-height: 1 !important;
}

.tribe-events .tribe-events-c-top-bar__datepicker-button-text {
  font-size: 15px !important;
  font-weight: 600 !important;
  line-height: 1 !important;
}

.tribe-events .tribe-events-c-top-bar__datepicker-button-icon {
  transform: scale(.85) !important;
}

/* Make "Today" readable */
.tribe-events .tribe-events-c-top-bar__today-button {
  color: rgba(255,255,255,.92) !important;
  opacity: 1 !important;
}

/* ---------- 8) Month label "January 2026" color (gold/white instead of black) ---------- */
.tribe-events .tribe-events-calendar-list__month-separator-text,
.tribe-events .tribe-events-calendar-list__month-separator time,
.tribe-events [class*="month-separator"] {
  color: rgba(212,175,55,.92) !important;
}

/* Optional: tighten the month separator spacing slightly */
.tribe-events .tribe-events-calendar-list__month-separator {
  margin: 8px 0 10px !important;
  padding: 6px 0 !important;
}

/* =========================================================
   SACRED GROUND — TEC TOP CONTROLS (FINAL / SINGLE SOURCE)
   Restores last-night look:
   - slim black box
   - removes big TEC headline
   - removes Find Events button
   - centered title
   - smaller date pill
   - readable Today
   - tighter bottom padding
   - month separator text not black
   Paste at VERY BOTTOM of Additional CSS
   ========================================================= */

/* 1) Hide the BIG TEC headline/title area (the “66+ …” line) */
.tribe-events .tribe-events-header__title,
.tribe-events .tribe-events-header__title-text,
.tribe-events .tribe-events-header h1,
.tribe-events .tribe-events-header h2{
  display: none !important;
}

/* 2) Make the “black box” feel like one clean card + reduce height */
.tribe-events .tribe-events-c-events-bar,
.tribe-events .tribe-events-header__events-bar{
  background: rgba(10, 8, 18, 0.70) !important;
  border: 1px solid rgba(212,175,55,0.18) !important;
  border-radius: 18px !important;
  box-shadow: 0 10px 30px rgba(0,0,0,0.35) !important;
  padding: 14px 16px 10px !important;  /* tighter bottom */
  margin-bottom: 12px !important;
}

/* Remove extra inner panels so it’s not “double boxed” */
.tribe-events .tribe-events-c-events-bar__views,
.tribe-events .tribe-events-c-events-bar__search,
.tribe-events .tribe-events-c-top-bar{
  background: transparent !important;
  box-shadow: none !important;
}

/* 3) ONE centered title (single source of truth) */
.tribe-events .tribe-events-c-top-bar__title{
  display: none !important;
}

.tribe-events .tribe-events-c-top-bar::before{
  content: "✨ A Calendar of Sacred Experiences ✨" !important;
  display: block !important;
  width: 100% !important;
  text-align: center !important;
  margin: 0 0 8px 0 !important;
  letter-spacing: .16em !important;
  text-transform: uppercase !important;
  font-size: 16px !important; /* +2 points */
  line-height: 1.2 !important;
  color: #d4af37 !important;
}

/* 4) Tighten spacing between rows (search row vs date row) */
.tribe-events .tribe-events-c-top-bar{
  padding: 6px 8px 4px !important; /* tighter bottom */
}

.tribe-events .tribe-events-c-top-bar__nav,
.tribe-events .tribe-events-c-top-bar__datepicker{
  margin-top: 6px !important;
  margin-bottom: 4px !important; /* tighter bottom */
  padding-bottom: 0 !important;
}

/* 5) Remove Find Events button (Enter still searches) */
.tribe-events .tribe-events-c-search__button{
  display: none !important;
}

/* 6) Search input: ensure magnifier doesn’t cover typed text */
.tribe-events .tribe-events-c-search__input-control,
.tribe-events input[type="search"]{
  padding-left: 46px !important; /* pushes text right of icon */
}

/* 7) View toggle pills (List/Month/Day) */
.tribe-events .tribe-events-c-view-selector__button{
  border-radius: 999px !important;
  padding: 8px 14px !important;
  font-size: 13px !important;
  font-weight: 600 !important;
  background: rgba(212,175,55,0.10) !important;
  border: 1px solid rgba(212,175,55,0.22) !important;
  color: #d4af37 !important;
}

.tribe-events .tribe-events-c-view-selector__button:hover{
  background: rgba(212,175,55,0.18) !important;
}

/* 8) Date pill ("Now - January 10") small + clean */
.tribe-events .tribe-events-c-top-bar__datepicker-button,
.tribe-events button.tribe-events-c-top-bar__datepicker-button{
  padding: 8px 14px !important;
  min-height: 34px !important;
  height: 34px !important;
  border-radius: 18px !important;
  font-size: 15px !important;
  line-height: 1 !important;
}

.tribe-events .tribe-events-c-top-bar__datepicker-button-text{
  font-size: 15px !important;
  font-weight: 600 !important;
  line-height: 1 !important;
}

.tribe-events .tribe-events-c-top-bar__datepicker-button-icon{
  transform: scale(.85) !important;
}

/* 9) Today button readable (not ghost gray) */
.tribe-events .tribe-events-c-top-bar__today-button{
  color: rgba(255,255,255,.92) !important;
  opacity: 1 !important;
}

/* 10) Month separator “January 2026” should not be black */
.tribe-events .tribe-events-calendar-list__month-separator-text,
.tribe-events time.tribe-events-calendar-list__month-separator-text{
  color: #d4af37 !important;
  opacity: .95 !important;
}

/* =========================================================
   TEC — FINAL HARD OVERRIDES
   Kill legacy header + tighten bottom padding
   ========================================================= */

/* 1) FORCE-KILL the stubborn legacy title (66+ Transformative...) */
.tribe-events .tribe-events-c-events-bar h2,
.tribe-events .tribe-events-c-events-bar h3,
.tribe-events .tribe-events-c-events-bar [class*="title"],
.tribe-events .tribe-events-header h2,
.tribe-events .tribe-events-header h3 {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* 2) Remove any leftover pseudo-elements injecting text */
.tribe-events .tribe-events-c-events-bar::before,
.tribe-events .tribe-events-c-events-bar::after,
.tribe-events .tribe-events-header::before,
.tribe-events .tribe-events-header::after {
  content: none !important;
  display: none !important;
}

/* 3) Tighten BOTTOM padding of the black box specifically */
.tribe-events .tribe-events-c-events-bar,
.tribe-events .tribe-events-header__events-bar {
  padding-bottom: 8px !important; /* was too tall */
  margin-bottom: 10px !important;
}

/* 4) Tighten the date row spacing */
.tribe-events .tribe-events-c-top-bar__datepicker {
  margin-bottom: 4px !important;
  padding-bottom: 4px !important;
}

/* =========================================================
   TEC — MICRO TIGHTEN (BOTTOM SPACING ONLY)
   Paste at VERY BOTTOM (under FINAL HARD OVERRIDES)
   ========================================================= */

/* 1) Tighten the bottom of the whole black controls area */
.tribe-events .tribe-events-c-events-bar,
.tribe-events .tribe-events-header__events-bar{
  padding-bottom: 10px !important;   /* try 10px; if you want tighter use 8px */
  margin-bottom: 10px !important;    /* reduces the gap before "January 2026" */
}

/* 2) Tighten the date-row panel inside the black box */
.tribe-events .tribe-events-c-top-bar{
  padding-bottom: 6px !important;
  margin-bottom: 0 !important;
}

/* 3) Tighten the date controls row spacing specifically */
.tribe-events .tribe-events-c-top-bar__datepicker{
  margin-bottom: 2px !important;
  padding-bottom: 2px !important;
}

/* =========================================================
   TEC — SEARCH UX (FINAL MERGED, SAFE)
   - typed text never sits under magnifier
   - icons don't steal clicks
   - gold clear X (TEC clear button)
   - optional: style JS-injected clear button (only if used)
   ========================================================= */

/* 1) Positioning context */
.tribe-events .tribe-events-c-search__input-control-wrap,
.tribe-events .tribe-events-c-search__input-control{
  position: relative !important;
}

/* 2) Padding ONLY on the actual input (not wrapper) */
.tribe-events .tribe-events-c-search__input-control input,
.tribe-events .tribe-events-c-search input[type="search"],
.tribe-events .tribe-events-c-search input[type="text"]{
  padding-left: 56px !important;   /* clears magnifier */
  padding-right: 44px !important;  /* room for X */
  box-sizing: border-box !important;
}

/* 3) Magnifier never steals clicks */
.tribe-events .tribe-events-c-search__input-control-icon,
.tribe-events .tribe-events-c-search__input-control-icon svg,
.tribe-events .tribe-events-c-search__input-control-icon-wrap{
  pointer-events: none !important;
  left: 18px !important;
}

/* 4) TEC in-field clear button = GOLD */
.tribe-events .tribe-events-c-search__input-control-clear,
.tribe-events .tribe-events-c-search__input-control-clear-button,
.tribe-events .tribe-events-c-search__clear-button{
  color: #d4af37 !important;
  opacity: 1 !important;
  text-decoration: none !important;
}

.tribe-events .tribe-events-c-search__input-control-clear svg,
.tribe-events .tribe-events-c-search__input-control-clear-button svg,
.tribe-events .tribe-events-c-search__clear-button svg{
  fill: #d4af37 !important;
  stroke: #d4af37 !important;
}

.tribe-events .tribe-events-c-search__input-control-clear svg *,
.tribe-events .tribe-events-c-search__input-control-clear-button svg *,
.tribe-events .tribe-events-c-search__clear-button svg *{
  fill: #d4af37 !important;
  stroke: #d4af37 !important;
}

/* 5) OPTIONAL BACKUP: if JS injects .sg-tec-clear, style it (won’t affect TEC’s native X) */
.tribe-events .sg-tec-clear{
  position: absolute !important;
  right: 14px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  width: 28px !important;
  height: 28px !important;
  border-radius: 999px !important;
  border: 1px solid rgba(212,175,55,.28) !important;
  background: rgba(26,14,39,.55) !important;
  color: #d4af37 !important; /* gold */
  font-size: 18px !important;
  line-height: 26px !important;
  text-align: center !important;
  cursor: pointer !important;
  z-index: 9 !important;
}

/* TEC — Prev/Next: anchor to left + right edges */
.tribe-events .tribe-events-c-nav__list {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center;
  width: 100%;
  max-width: 1100px;
  margin: 18px auto 0;
  gap: 18px;
  padding: 0;
}

.tribe-events .tribe-events-c-nav__list-item {
  flex: 0 0 auto;
}
/* =========================================================
   TEC — Prev / Next pills: FIX LAYOUT + FULL CLICK AREA
   ========================================================= */

/* Force desktop layout: two pills side-by-side */
@media (min-width: 768px) {
  .tribe-events .tribe-events-c-nav__list {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 18px !important;
    max-width: 1100px;
    margin: 18px auto 0;
    width: 100%;
  }
}

/* Mobile stays stacked, but centered and not awkward */
@media (max-width: 767px) {
  .tribe-events .tribe-events-c-nav__list {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 14px !important;
    max-width: 520px;
    margin: 18px auto 0;
    width: 100%;
  }
}

/* The gold pill container (usually where the background lives) */
.tribe-events .tribe-events-c-nav__list-item {
  position: relative;
  min-height: 44px;
  border-radius: 999px;
  overflow: hidden;
}

/* If the gold gradient is a pseudo-element, it can block clicks */
.tribe-events .tribe-events-c-nav__list-item::before,
.tribe-events .tribe-events-c-nav__list-item::after {
  pointer-events: none !important;
}

/* Make the LINK cover the ENTIRE pill so the whole gold area clicks */
.tribe-events .tribe-events-c-nav__list-item a {
  position: absolute !important;
  inset: 0 !important;
  z-index: 10 !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  padding: 10px 18px;
  text-decoration: none;
  width: 100%;
  height: 100%;
}

/* Don’t let inner spans/icons steal the click */
.tribe-events .tribe-events-c-nav__list-item a * {
  pointer-events: none;
}

/* TEC — position Prev/Next pills: align to content edges */
.tribe-events .tribe-events-c-nav {
  max-width: 1100px;      /* match your content feel */
  margin: 0 auto;         /* center the nav block itself */
  padding: 0 40px;        /* give left/right breathing room */
}

.tribe-events .tribe-events-c-nav__list {
  display: flex !important;
  justify-content: space-between !important;  /* prev left, next right */
  align-items: center;
  width: 100%;
  gap: 18px;
  margin-top: 18px;
}

/* keep each pill from stretching */
.tribe-events .tribe-events-c-nav__list-item {
  flex: 0 0 auto;
}

/* SACRED GROUND: Product text visibility fix */
.tax-product_cat .woocommerce-loop-product__title,
.tax-product_cat .price,
.tax-product_cat .amount,
.tax-product_cat .product-excerpt,
.tax-product_cat h2.woocommerce-loop-product__title,
.tax-product_cat span.price,
.woocommerce.tax-product_cat ul.products li.product .woocommerce-loop-product__title,
.woocommerce.tax-product_cat ul.products li.product .price,
.woocommerce.tax-product_cat ul.products li.product h2,
.woocommerce.tax-product_cat ul.products li.product .price * {
    color: #FFFFFF !important;
    font-weight: 700 !important;
}

/* About page - push content below Kadence header */
.page-id-YOUR_PAGE_ID .ml-canvas-block-content .content,
body.page-template-default .ml-canvas-block-content .content {
    padding-top: 80px;
}

/* ==========================================================
   SACRED GROUND — SHOP PAGE STYLES
   Calm, minimal, elevated WooCommerce shop styling
   ========================================================= */

/* ---------- SHOP PAGE BASE ---------- */
body.woocommerce-shop,
body.tax-product_cat,
body.single-product {
  background: radial-gradient(1200px 800px at 50% 15%, rgba(120, 95, 195, 0.25), rgba(0,0,0,0) 55%),
              linear-gradient(180deg, #2a1456 0%, #1b0f33 70%, #140a26 100%) !important;
}

/* ---------- SHOP PAGE TITLE ---------- */
.woocommerce-products-header,
.woocommerce-products-header__title {
  color: #d4af37 !important;
  font-weight: 400 !important;
  letter-spacing: 0.5px;
  margin-bottom: 30px;
}

/* ---------- PRODUCT GRID: CALM SPACING ---------- */
.woocommerce ul.products {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  margin: 0;
  padding: 0;
  list-style: none;
}

@media (max-width: 1200px) {
  .woocommerce ul.products {
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }
}

@media (max-width: 768px) {
  .woocommerce ul.products {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 480px) {
  .woocommerce ul.products {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

/* ---------- PRODUCT CARDS: ELEVATED GLASS EFFECT ---------- */
.woocommerce ul.products li.product {
  background: rgba(20, 10, 38, 0.65) !important;
  border: 1px solid rgba(212, 175, 55, 0.15) !important;
  border-radius: 16px !important;
  padding: 20px !important;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
}

.woocommerce ul.products li.product:hover {
  transform: translateY(-4px);
  border-color: rgba(212, 175, 55, 0.35) !important;
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4);
}

/* ---------- PRODUCT IMAGES: 1:1 SQUARE ---------- */
.woocommerce ul.products li.product img {
  width: 100% !important;
  height: auto !important;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 16px;
  background: rgba(255, 255, 255, 0.05);
}

/* ---------- PRODUCT TITLES ---------- */
.woocommerce ul.products li.product .woocommerce-loop-product__title,
.woocommerce ul.products li.product h2 {
  color: #d4a027 !important;
  font-size: 16px !important;
  font-weight: 500 !important;
  line-height: 1.4;
  margin: 0 0 12px 0 !important;
  padding: 0;
  letter-spacing: 0.3px;
}

.woocommerce ul.products li.product .woocommerce-loop-product__title a {
  color: #d4a027 !important;
  text-decoration: none;
  transition: color 0.2s ease;
}

.woocommerce ul.products li.product .woocommerce-loop-product__title a:hover {
  color: #d4af37 !important;
}

/* ---------- PRICES: GOLD ACCENT ---------- */
.woocommerce ul.products li.product .price,
.woocommerce ul.products li.product .amount {
  color: #d4af37 !important;
  font-size: 18px !important;
  font-weight: 600 !important;
  margin: 0;
}

.woocommerce ul.products li.product .price del {
  color: rgba(255, 255, 255, 0.4) !important;
  font-size: 14px;
}

.woocommerce ul.products li.product .price ins {
  color: #d4af37 !important;
  text-decoration: none;
}

/* ---------- ADD TO CART BUTTONS: SUBTLE ---------- */
.woocommerce ul.products li.product .button,
.woocommerce ul.products li.product .add_to_cart_button {
  background: rgba(212, 175, 55, 0.15) !important;
  border: 1px solid rgba(212, 175, 55, 0.4) !important;
  color: #d4af37 !important;
  border-radius: 8px;
  padding: 10px 20px !important;
  font-size: 14px;
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0.5px;
  transition: all 0.2s ease;
  margin-top: auto;
  width: 100%;
}

.woocommerce ul.products li.product .button:hover,
.woocommerce ul.products li.product .add_to_cart_button:hover {
  background: rgba(212, 175, 55, 0.25) !important;
  border-color: rgba(212, 175, 55, 0.6) !important;
  color: #f2d889 !important;
  transform: none;
}

/* ---------- SINGLE PRODUCT PAGE ---------- */
.single-product .product {
  background: rgba(20, 10, 38, 0.4) !important;
  border-radius: 16px;
  padding: 40px;
  margin-bottom: 40px;
}

.single-product .product_title {
  color: #d4af37 !important;
  font-size: 32px;
  font-weight: 400;
  margin-bottom: 20px;
}

.single-product .price {
  color: #d4af37 !important;
  font-size: 24px;
  font-weight: 600;
}

.single-product .woocommerce-product-details__short-description {
  color: rgba(255, 255, 255, 0.85);
  font-size: 16px;
  line-height: 1.6;
  margin: 20px 0;
}

.single-product .woocommerce-product-details__short-description p {
  margin: 0 0 12px 0;
}

/* ---------- RELATED PRODUCTS SECTION ---------- */
.woocommerce .related.products {
  margin-top: 60px;
  padding-top: 40px;
  border-top: 1px solid rgba(212, 175, 55, 0.15);
}

.woocommerce .related.products h2 {
  color: #d4af37 !important;
  font-size: 24px;
  font-weight: 400;
  margin-bottom: 30px;
  text-align: center;
}

/* ---------- CATEGORY FILTERS: MINIMAL ---------- */
.woocommerce .widget_product_categories,
.woocommerce .widget_layered_nav {
  background: rgba(20, 10, 38, 0.4);
  border: 1px solid rgba(212, 175, 55, 0.15);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 30px;
}

.woocommerce .widget_product_categories .widget-title,
.woocommerce .widget_layered_nav .widget-title {
  color: #d4af37 !important;
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 15px;
}

.woocommerce .widget_product_categories ul li a {
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: color 0.2s ease;
}

.woocommerce .widget_product_categories ul li a:hover {
  color: #d4af37;
}

/* ---------- SHOP FOOTER SECTION (EVENTS LINK) ---------- */
.sg-shop-footer-section {
  text-align: center;
  margin-top: 60px;
  padding: 40px 20px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 15px;
  line-height: 1.6;
}

.sg-shop-footer-section a {
  color: #d4af37 !important;
  text-decoration: none;
  transition: color 0.2s ease;
}

.sg-shop-footer-section a:hover {
  color: #f2d889 !important;
}

/* ---------- CART & CHECKOUT: MINIMAL ---------- */
.woocommerce-cart .cart,
.woocommerce-checkout {
  background: rgba(20, 10, 38, 0.4);
  border-radius: 16px;
  padding: 30px;
}

.woocommerce table.shop_table {
  border: 1px solid rgba(212, 175, 55, 0.15);
  border-radius: 12px;
  background: rgba(20, 10, 38, 0.3);
}

.woocommerce table.shop_table th {
  color: #d4af37;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.woocommerce table.shop_table td {
  color: rgba(255, 255, 255, 0.9);
  border-bottom: 1px solid rgba(212, 175, 55, 0.1);
}

.woocommerce .button.checkout-button,
.woocommerce #place_order {
  background: rgba(212, 175, 55, 0.2) !important;
  border: 1px solid rgba(212, 175, 55, 0.5) !important;
  color: #d4af37 !important;
  border-radius: 8px;
  padding: 14px 28px;
  font-size: 16px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.woocommerce .button.checkout-button:hover,
.woocommerce #place_order:hover {
  background: rgba(212, 175, 55, 0.3) !important;
  border-color: rgba(212, 175, 55, 0.7) !important;
  color: #f2d889 !important;
}

/* ---------- MYSTERY BOX SPECIAL STYLING ---------- */
.tax-product_cat-mystery-boxes .woocommerce-loop-product__title::after {
  content: " ✨";
  color: #d4af37;
}

/* ---------- REMOVE CLUTTER: HIDE PRODUCT COUNT ---------- */
.woocommerce .product-categories .count,
.woocommerce .widget_product_categories .count {
  display: none;
}

/* ---------- LOADING STATES: SUBTLE ---------- */
.woocommerce .button.loading::after {
  border-color: #d4af37 transparent transparent transparent;
}

/* ---------- CUSTOM SHOP PAGE: HIDE IN-STORE EXCLUSIVES ---------- */
body.page-slug-shop-11 .in-store-exclusives,
body.page-slug-shop-11 [class*="exclusive"],
body.page-slug-shop-11 [id*="exclusive"],
body.page-slug-shop-11 section:has-text("In-Store Exclusives"),
body.page-slug-shop-11 div:has-text("In-Store Exclusives") {
  display: none !important;
}

body.page-slug-shop-11 [class*="loading"][class*="exclusive"],
body.page-slug-shop-11 [id*="loading"][id*="exclusive"],
body.page-slug-shop-11 *:contains("Loading exclusive finds") {
  display: none !important;
}

body.page-slug-shop-11 *:contains("Visit the Shop or Call Ahead") {
  display: none !important;
}

/* ---------- SHOP PAGE TITLE STYLING ---------- */
body.page-slug-shop-11 h1,
body.page-slug-shop-11 .entry-title,
body.page-slug-shop-11 .page-title {
  color: #d4af37 !important;
  font-weight: 400 !important;
  letter-spacing: 0.5px;
  margin-bottom: 30px;
}

/* ---------- SHOP BY CATEGORY SECTION ---------- */
body.page-slug-shop-11 .wp-block-group,
body.page-slug-shop-11 [class*="category"],
body.page-slug-shop-11 [class*="shop-by"] {
  color: rgba(255, 255, 255, 0.9);
}

body.page-slug-shop-11 .wp-block-group a,
body.page-slug-shop-11 [class*="category"] a {
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  transition: color 0.2s ease;
}

body.page-slug-shop-11 .wp-block-group a:hover,
body.page-slug-shop-11 [class*="category"] a:hover {
  color: #d4af37;
}

body.page-slug-shop-11 *:contains("Classes & Experiences"),
body.page-slug-shop-11 *:contains("Oracle, Tarot & Books") {
  display: none !important;
}

/* ---------- RESPONSIVE: MOBILE OPTIMIZATION ---------- */
@media (max-width: 768px) {
  .single-product .product {
    padding: 20px;
  }
  
  .woocommerce-cart .cart,
  .woocommerce-checkout {
    padding: 20px;
  }
}

/* ==========================================================
   COMPLETE SHOP PAGE STYLING - MATCHES SHOP-11 PAGE
   ========================================================= */

/* ---------- FORCE PURPLE GRADIENT ON ALL SHOP PAGES ---------- */
body.woocommerce-shop,
body.tax-product_cat,
body.single-product,
body.woocommerce-shop .site-content,
body.tax-product_cat .site-content,
body.single-product .site-content,
body.woocommerce-shop .content-area,
body.tax-product_cat .content-area,
body.single-product .content-area,
body.woocommerce-shop main,
body.tax-product_cat main,
body.single-product main {
  background: radial-gradient(1200px 800px at 50% 15%, rgba(120, 95, 195, 0.25), rgba(0,0,0,0) 55%),
              linear-gradient(180deg, #2a1456 0%, #1b0f33 70%, #140a26 100%) !important;
}

/* ---------- REMOVE ALL BEIGE BACKGROUNDS FROM HERO SECTIONS (AGGRESSIVE) ---------- */
body.tax-product_cat .entry-hero,
body.tax-product_cat .page-hero,
body.tax-product_cat .kadence-entry-hero,
body.tax-product_cat .entry-hero-wrap,
body.tax-product_cat .entry-hero-container,
body.tax-product_cat .entry-hero-content,
body.tax-product_cat .entry-hero-inner,
body.tax-product_cat .entry-hero-inner *,
body.tax-product_cat .entry-hero *,
body.tax-product_cat .kadence-entry-hero *,
body.single-product .entry-hero,
body.single-product .page-hero,
body.single-product .kadence-entry-hero,
body.single-product .entry-hero-wrap,
body.single-product .entry-hero-container,
body.single-product .entry-hero-content,
body.single-product .entry-hero-inner,
body.single-product .entry-hero-inner *,
body.single-product .entry-hero *,
body.single-product .kadence-entry-hero * {
  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;
}

/* ---------- ADD STARS BACKGROUND (LIKE SHOP-11) ---------- */
body.tax-product_cat::before,
body.single-product::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, #0a0614, #1a0e27, #2d1b4e, #3d2463, #4a1942, #5b2b6f);
  background-size: 400% 400%;
  animation: gradientShift 15s ease infinite;
  z-index: -3;
  pointer-events: none;
}

body.tax-product_cat::after,
body.single-product::after {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 20% 50%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
              radial-gradient(circle at 80% 80%, rgba(66, 153, 225, 0.1) 0%, transparent 50%);
  z-index: -2;
  pointer-events: none;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ---------- STARS CONTAINER (WILL BE POPULATED BY JS) ---------- */
body.tax-product_cat .sg-stars-container,
body.single-product .sg-stars-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}

.sg-star {
  position: absolute;
  background: white;
  border-radius: 50%;
}

.sg-star--small {
  width: 1px;
  height: 1px;
  animation: twinkle-slow 4s infinite;
}

.sg-star--medium {
  width: 2px;
  height: 2px;
  animation: twinkle-medium 3s infinite;
}

.sg-star--large {
  width: 3px;
  height: 3px;
  animation: twinkle-fast 2.5s infinite;
  box-shadow: 0 0 4px rgba(255, 255, 255, 0.5);
}

@keyframes twinkle-slow {
  0%, 100% { opacity: 0.15; }
  50% { opacity: 0.5; }
}

@keyframes twinkle-medium {
  0%, 100% { opacity: 0.2; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

@keyframes twinkle-fast {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.4); }
}

/* ---------- CATEGORY PAGE TITLE: RAINBOW GRADIENT (LIKE SHOP-11) ---------- */
body.tax-product_cat .woocommerce-products-header h1,
body.tax-product_cat .woocommerce-products-header__title h1,
body.tax-product_cat h1.page-title,
body.tax-product_cat h1.entry-title,
body.tax-product_cat .page-title,
body.tax-product_cat .entry-title,
body.tax-product_cat .entry-hero-title,
body.tax-product_cat .entry-hero h1,
body.tax-product_cat .kadence-entry-hero h1 {
  font-size: clamp(2.5rem, 6vw, 4rem) !important;
  font-weight: 200 !important;
  background: linear-gradient(90deg, #FFD700 0%, #FFA500 30%, #9333ea 70%, #4299e1 100%) !important;
  -webkit-background-clip: text !important;
  -webkit-text-fill-color: transparent !important;
  background-clip: text !important;
  margin-bottom: 12px !important;
  letter-spacing: 12px !important;
  text-transform: uppercase !important;
  text-shadow: none !important;
  line-height: 1.2 !important;
  padding: 30px 0 20px !important;
  text-align: center !important;
}

/* ---------- ALL TEXT ON CATEGORY PAGES: WHITE ---------- */
body.tax-product_cat,
body.tax-product_cat *,
body.tax-product_cat p,
body.tax-product_cat span,
body.tax-product_cat div,
body.tax-product_cat li,
body.single-product,
body.single-product *,
body.single-product p,
body.single-product span,
body.single-product div,
body.single-product li {
  color: #ffffff !important;
}

/* ---------- EXCEPTIONS: KEEP RAINBOW GRADIENT FOR TITLES ---------- */
body.tax-product_cat h1,
body.tax-product_cat .woocommerce-products-header h1,
body.tax-product_cat .entry-hero-title {
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
}

/* ---------- PRICES STAY GOLD ---------- */
body.tax-product_cat .price,
body.tax-product_cat .amount,
body.single-product .price,
body.single-product .amount {
  color: #d4af37 !important;
}

/* ---------- NO HOVER EFFECTS - CLICKABLE ONLY ---------- */
.woocommerce ul.products li.product:hover,
.woocommerce ul.products li.product:hover *,
.woocommerce ul.products li.product .woocommerce-loop-product__title a:hover,
.woocommerce ul.products li.product h2 a:hover,
.woocommerce ul.products li.product:hover .woocommerce-loop-product__title a,
.woocommerce ul.products li.product:hover h2 a {
  color: #d4a027 !important;
  text-decoration: none !important;
  transform: none !important;
  border-color: rgba(212, 175, 55, 0.15) !important;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
}

/* ---------- DISABLE ALL HOVER TRANSITIONS ---------- */
.woocommerce ul.products li.product,
.woocommerce ul.products li.product *,
.woocommerce ul.products li.product a,
.woocommerce ul.products li.product .button {
  transition: none !important;
}

/* HERO CENTERING FIX */
.woocommerce-products-header,
body.tax-product_cat .woocommerce-products-header {
    width: 100% !important;
    text-align: center !important;
    display: block !important;
}

.woocommerce-products-header__title,
h1.woocommerce-products-header__title,
h1.page-title {
    width: 100% !important;
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
}

.entry-hero-container-inner,
.kadence-entry-hero,
.entry-header {
    width: 100% !important;
    text-align: center !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
}

.entry-title,
h1.entry-title {
    width: 100% !important;
    text-align: center !important;
}

/* PADDING REDUCTION */
.woocommerce-products-header {
    margin-bottom: 15px !important;
    padding-bottom: 0 !important;
}

ul.products {
    margin-top: 15px !important;
}

/* MYSTERY BOX PRICES - Show under titles */
body.tax-product_cat.term-mystery-boxes .woocommerce-Price-amount,
body.tax-product_cat.term-mystery-boxes .price {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    color: #d4a027 !important;
    text-align: center !important;
    margin-top: 8px !important;
}

/* MORE PADDING REDUCTION - Cut another 50% */
.woocommerce-products-header {
    margin-bottom: 8px !important;
    padding-bottom: 0 !important;
}

ul.products {
    margin-top: 8px !important;
    padding-top: 0 !important;
}

.entry-hero-container-inner {
    margin-bottom: 8px !important;
    padding-bottom: 0 !important;
}

/* STARS ON ALL PAGES */
body::before {
    content: '' !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none !important;
    z-index: -1 !important;
    background-image: 
        radial-gradient(2px 2px at 20px 30px, white, transparent),
        radial-gradient(2px 2px at 40px 70px, rgba(255,255,255,0.8), transparent),
        radial-gradient(1px 1px at 90px 40px, white, transparent),
        radial-gradient(2px 2px at 160px 120px, rgba(255,255,255,0.9), transparent),
        radial-gradient(1px 1px at 230px 80px, white, transparent),
        radial-gradient(2px 2px at 300px 150px, rgba(255,255,255,0.7), transparent),
        radial-gradient(1px 1px at 370px 50px, white, transparent),
        radial-gradient(2px 2px at 450px 180px, white, transparent),
        radial-gradient(1px 1px at 520px 90px, rgba(255,255,255,0.8), transparent),
        radial-gradient(2px 2px at 600px 130px, white, transparent) !important;
    background-size: 650px 200px !important;
    background-repeat: repeat !important;
    animation: twinkle 4s ease-in-out infinite !important;
}

@keyframes twinkle {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
}

/* =========================================================
   SHOPIFY SHOP — FINAL SINGLE SOURCE (LOCKED)
   Page: /shopify-shop/  Page ID: 20365
   Sacred Ground Gold: #D8B052 (RGB: 216, 176, 82)
   ========================================================= */

body.page-id-20365{
  --sg-gold: #D8B052;
  --sg-btn-text: #111111;
}

/* ---------------------------
   1) HERO: title + tagline
   --------------------------- */
body.page-id-20365 .entry-content h1,
body.page-id-20365 .entry-title,
body.page-id-20365 .wp-block-post-title{
  color:#ffffff !important;
  text-align:center !important;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* tagline = first paragraph directly after first heading */
body.page-id-20365 .entry-content h1 + p,
body.page-id-20365 .entry-content .wp-block-heading:first-of-type + p,
body.page-id-20365 .entry-content > p:first-of-type{
  color:#ffffff !important;
  font-size:24px !important;
  line-height:1.65 !important;
  font-weight:500 !important;
  text-align:center !important;
  max-width:760px !important;
  margin:14px auto 34px !important;
  opacity:1 !important;
}

/* section headings */
body.page-id-20365 h2,
body.page-id-20365 h3,
body.page-id-20365 .wp-block-heading{
  color:#ffffff !important;
}

/* ---------------------------
   2) Layout width for Woo blocks
   --------------------------- */
body.page-id-20365 .wp-block-woocommerce-featured-products,
body.page-id-20365 .wp-block-woocommerce-product-collection,
body.page-id-20365 .wp-block-woocommerce-products-by-category,
body.page-id-20365 .wp-block-woocommerce-products{
  max-width:1200px !important;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* ---------------------------
   3) Product cards: stable structure
   --------------------------- */
body.page-id-20365 .wc-block-grid__product,
body.page-id-20365 .wc-block-product,
body.page-id-20365 li.product{
  display:flex !important;
  flex-direction:column !important;
  background:#ffffff !important;
  border-radius:16px !important;
  box-shadow:0 10px 30px rgba(0,0,0,0.18) !important;

  /* IMPORTANT: do NOT clip content (titles/prices) */
  overflow:visible !important;
}

/* ---------------------------
   4) Image height normalization (wrapper + fallback)
   --------------------------- */

/* Preferred: if wrapper exists, clip wrapper only */
body.page-id-20365 .wc-block-components-product-image,
body.page-id-20365 .wc-block-grid__product-image,
body.page-id-20365 .wc-block-product__image{
  height:260px !important;
  overflow:hidden !important;
  border-radius:12px !important;
}

body.page-id-20365 .wc-block-components-product-image img,
body.page-id-20365 .wc-block-grid__product-image img,
body.page-id-20365 .wc-block-product__image img{
  width:100% !important;
  height:100% !important;
  object-fit:cover !important;
  display:block !important;
}

/* Fallback: if Woo outputs no wrapper */
body.page-id-20365 .wc-block-grid__product img,
body.page-id-20365 .wc-block-product img,
body.page-id-20365 li.product img{
  width:100% !important;
  height:260px !important;
  object-fit:cover !important;
  display:block !important;
}

/* ---------------------------
   5) Titles + prices: visibility kill-switch
   --------------------------- */
body.page-id-20365 .wc-block-components-product-name,
body.page-id-20365 .wc-block-grid__product-title,
body.page-id-20365 .wc-block-components-product-title,
body.page-id-20365 .woocommerce-loop-product__title,
body.page-id-20365 .wc-block-components-product-price,
body.page-id-20365 .wc-block-grid__product-price,
body.page-id-20365 .price{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
  color:#111111 !important;
  -webkit-text-fill-color:#111111 !important;
  text-align:center !important;
}

/* Title link specifically (common offender) */
body.page-id-20365 .wc-block-components-product-name__link,
body.page-id-20365 .wc-block-grid__product-title a,
body.page-id-20365 .wc-block-components-product-title a,
body.page-id-20365 .woocommerce-loop-product__title a{
  color:#111111 !important;
  -webkit-text-fill-color:#111111 !important;
  text-decoration:none !important;
  opacity:1 !important;
  visibility:visible !important;
  text-indent:0 !important;
  font-size:16px !important;
  line-height:1.25 !important;
}

/* Keep title rows even */
body.page-id-20365 .wc-block-components-product-name,
body.page-id-20365 .wc-block-grid__product-title{
  min-height:2.6em !important;
  display:-webkit-box !important;
  -webkit-line-clamp:2 !important;
  -webkit-box-orient:vertical !important;
  overflow:hidden !important;
}

/* ---------------------------
   6) Buttons: gold pill + black text (wins)
   --------------------------- */

/* push button block to bottom */
body.page-id-20365 .wc-block-components-product-button,
body.page-id-20365 .wp-block-woocommerce-product-button{
  margin-top:auto !important;
  padding:0 14px 14px !important;
}

/* button anchors + Woo button */
body.page-id-20365 .wp-block-woocommerce-product-button a,
body.page-id-20365 .wc-block-components-product-button a,
body.page-id-20365 .wc-block-components-button,
body.page-id-20365 a.add_to_cart_button,
body.page-id-20365 a.product_type_simple,
body.page-id-20365 a.product_type_variable{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;

  width:100% !important;
  padding:14px 18px !important;

  background:var(--sg-gold) !important;
  color:var(--sg-btn-text) !important;
  -webkit-text-fill-color:var(--sg-btn-text) !important;

  border:none !important;
  border-radius:999px !important;

  font-weight:800 !important;
  font-size:15px !important;
  letter-spacing:0.02em !important;

  text-decoration:none !important;
  box-shadow:0 6px 18px rgba(0,0,0,0.22) !important;
  cursor:pointer !important;
}

/* hover */
@media (hover:hover){
  body.page-id-20365 .wp-block-woocommerce-product-button a:hover,
  body.page-id-20365 .wc-block-components-button:hover,
  body.page-id-20365 a.add_to_cart_button:hover{
    filter:brightness(0.95) !important;
  }
}
/* =========================================================
   SHOPIFY SHOP — WORKING CSS (Based on Actual HTML)
   Page: /shopify-shop/  Page ID: 20365
   Sacred Ground Gold: #D8B052 (RGB: 216, 176, 82)
   ========================================================= */

body.page-id-20365{
  --sg-gold: #D8B052;
  --sg-btn-text: #111111;
}

/* ---------------------------
   1) HERO: Center title + tagline
   --------------------------- */
body.page-id-20365 h1,
body.page-id-20365 .entry-title,
body.page-id-20365 .wp-block-post-title,
body.page-id-20365 h1.entry-title{
  color:#ffffff !important;
  text-align:center !important;
  margin-left:auto !important;
  margin-right:auto !important;
  width:100% !important;
}

/* Tagline paragraph */
body.page-id-20365 .entry-content > p:first-of-type,
body.page-id-20365 h1 + p{
  color:#ffffff !important;
  font-size:24px !important;
  line-height:1.65 !important;
  font-weight:500 !important;
  text-align:center !important;
  max-width:760px !important;
  margin:14px auto 34px !important;
  opacity:1 !important;
}

/* Section headings (Featured, etc.) */
body.page-id-20365 h2,
body.page-id-20365 h3,
body.page-id-20365 .wp-block-heading{
  color:#ffffff !important;
  text-align:center !important;
}

/* ---------------------------
   2) Product Collection container
   --------------------------- */
body.page-id-20365 .wp-block-woocommerce-product-collection,
body.page-id-20365 [data-block-name="woocommerce/product-collection"]{
  max-width:1200px !important;
  margin-left:auto !important;
  margin-right:auto !important;
}

/* ---------------------------
   3) Product Grid - Force visible products list
   --------------------------- */
body.page-id-20365 .wp-block-woocommerce-product-collection .wc-block-grid,
body.page-id-20365 .wc-block-product-collection__wrapper,
body.page-id-20365 ul.wp-block-post-template,
body.page-id-20365 .wc-block-grid__products{
  display:grid !important;
  grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)) !important;
  gap:20px !important;
  visibility:visible !important;
  opacity:1 !important;
}

/* ---------------------------
   4) Individual Product Cards
   --------------------------- */
body.page-id-20365 .wp-block-post,
body.page-id-20365 li.product,
body.page-id-20365 .wc-block-grid__product{
  display:flex !important;
  flex-direction:column !important;
  background:#ffffff !important;
  border-radius:16px !important;
  box-shadow:0 10px 30px rgba(0,0,0,0.18) !important;
  overflow:visible !important;
  padding:0 !important;
}

/* ---------------------------
   5) Product Images - 260px height
   --------------------------- */
body.page-id-20365 .wp-block-post img,
body.page-id-20365 li.product img,
body.page-id-20365 .wc-block-grid__product img,
body.page-id-20365 .wp-block-post-featured-image img{
  width:100% !important;
  height:260px !important;
  object-fit:cover !important;
  display:block !important;
  border-radius:12px 12px 0 0 !important;
}

/* Image wrapper if it exists */
body.page-id-20365 .wp-block-post-featured-image,
body.page-id-20365 .wc-block-components-product-image{
  height:260px !important;
  overflow:hidden !important;
  border-radius:12px 12px 0 0 !important;
  margin:0 !important;
}

/* ---------------------------
   6) PRODUCT TITLES - FORCE VISIBLE
   --------------------------- */
body.page-id-20365 .wp-block-post-title,
body.page-id-20365 h3.wp-block-post-title,
body.page-id-20365 .wc-block-components-product-name,
body.page-id-20365 .wc-block-grid__product-title,
body.page-id-20365 .woocommerce-loop-product__title{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
  
  color:#111111 !important;
  -webkit-text-fill-color:#111111 !important;
  
  font-size:16px !important;
  line-height:1.3 !important;
  font-weight:600 !important;
  text-align:center !important;
  
  margin:16px 14px 8px !important;
  padding:0 !important;
  
  height:auto !important;
  max-height:none !important;
  overflow:visible !important;
  
  position:relative !important;
  z-index:5 !important;
}

/* Title links */
body.page-id-20365 .wp-block-post-title a,
body.page-id-20365 h3.wp-block-post-title a,
body.page-id-20365 .wc-block-components-product-name a,
body.page-id-20365 .wc-block-grid__product-title a{
  color:#111111 !important;
  -webkit-text-fill-color:#111111 !important;
  text-decoration:none !important;
  opacity:1 !important;
  visibility:visible !important;
  font-size:16px !important;
  line-height:1.3 !important;
  display:inline !important;
}

/* ---------------------------
   7) PRICES - Force visible
   --------------------------- */
body.page-id-20365 .wp-block-woocommerce-product-price,
body.page-id-20365 .wc-block-components-product-price,
body.page-id-20365 .price,
body.page-id-20365 .wc-block-grid__product-price{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
  
  color:#111111 !important;
  -webkit-text-fill-color:#111111 !important;
  
  text-align:center !important;
  margin:0 14px 16px !important;
  font-size:18px !important;
  font-weight:600 !important;
}

/* ---------------------------
   8) BUTTONS - Gold pill with black text
   --------------------------- */
body.page-id-20365 .wp-block-button,
body.page-id-20365 .wc-block-components-product-button{
  margin-top:auto !important;
  padding:0 14px 18px !important;
  text-align:center !important;
}

body.page-id-20365 .wp-block-button__link,
body.page-id-20365 .wp-block-button a,
body.page-id-20365 .wc-block-components-button,
body.page-id-20365 .wc-block-components-product-button__button,
body.page-id-20365 a.add_to_cart_button,
body.page-id-20365 .add_to_cart_button,
body.page-id-20365 button.add_to_cart_button{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  
  width:calc(100% - 28px) !important;
  max-width:100% !important;
  padding:14px 24px !important;
  
  background:var(--sg-gold) !important;
  background-color:var(--sg-gold) !important;
  background-image:none !important;
  
  color:var(--sg-btn-text) !important;
  -webkit-text-fill-color:var(--sg-btn-text) !important;
  
  border:none !important;
  border-radius:999px !important;
  
  font-weight:800 !important;
  font-size:15px !important;
  letter-spacing:0.02em !important;
  text-transform:none !important;
  
  text-decoration:none !important;
  box-shadow:0 6px 18px rgba(0,0,0,0.22) !important;
  cursor:pointer !important;
  
  filter:none !important;
  opacity:1 !important;
  visibility:visible !important;
}

/* Button hover */
@media (hover:hover){
  body.page-id-20365 .wp-block-button__link:hover,
  body.page-id-20365 .wc-block-components-button:hover,
  body.page-id-20365 .add_to_cart_button:hover{
    background:var(--sg-gold) !important;
    background-color:var(--sg-gold) !important;
    filter:brightness(0.92) !important;
    color:var(--sg-btn-text) !important;
    -webkit-text-fill-color:var(--sg-btn-text) !important;
  }
}

/* ---------------------------
   9) Kill any transform/opacity on hover
   --------------------------- */
body.page-id-20365 .wp-block-post:hover .wp-block-post-title,
body.page-id-20365 .wp-block-post:hover .wp-block-post-title a{
  opacity:1 !important;
  visibility:visible !important;
  transform:none !important;
  color:#111111 !important;
  -webkit-text-fill-color:#111111 !important;
}

/* =========================================================
   SHOPIFY SHOP — SPACING FIX
   Add this to the bottom of Additional CSS
   ========================================================= */

/* Remove padding between nav and hero */
body.page-id-20365 .entry-header,
body.page-id-20365 .entry-hero,
body.page-id-20365 .site-content{
  padding-top:0 !important;
  margin-top:0 !important;
}

/* Hide the tagline paragraph */
body.page-id-20365 .entry-content > p:first-of-type,
body.page-id-20365 h1 + p{
  display:none !important;
}

/* Tighten up space after main title */
body.page-id-20365 h1,
body.page-id-20365 .entry-title{
  margin-bottom:20px !important;
  padding-bottom:0 !important;
}

/* Reduce space above "Featured" heading */
body.page-id-20365 h2:first-of-type,
body.page-id-20365 .wp-block-heading:first-of-type{
  margin-top:10px !important;
  padding-top:0 !important;
}

/* =========================================================
   SHOPIFY SHOP — ADD TOP PADDING FOR FEATURED SECTION
   Add this to the bottom of Additional CSS
   ========================================================= */

/* Add padding to top of page content so Featured heading isn't hidden */
body.page-id-20365 .entry-content{
  padding-top:120px !important;
}

/* OR if that's too much, try adjusting the Featured heading specifically */
body.page-id-20365 .entry-content > h2:first-of-type,
body.page-id-20365 .entry-content > .wp-block-heading:first-of-type{
  margin-top:100px !important;
  padding-top:20px !important;
}

/* =========================================================
   SINGLE PRODUCT — FINAL VISIBILITY + TAB FIX (SAFE)
   Kadence + Woo Blocks compatibility
   ========================================================= */

/* 1. FIX invisible variation dropdown + quantity */
.single-product .variations select,
.single-product .quantity input.qty {
  color: #ffffff !important;
  background-color: #2b1d47 !important; /* deep Sacred Ground purple */
  border: 1px solid rgba(255,255,255,0.35) !important;
}

.single-product .variations select option {
  color: #000000 !important; /* dropdown list readable */
}

/* 2. FIX placeholder / selected text visibility */
.single-product .variations select:focus,
.single-product .quantity input.qty:focus {
  outline: none;
  box-shadow: 0 0 0 1px rgba(212,175,55,0.6);
}

/* 3. REMOVE duplicate Woo "Additional Information" output */
.single-product .woocommerce-tabs,
.single-product .wc-tabs,
.single-product .woocommerce-Tabs-panel--additional_information {
  display: none !important;
}

/* 4. KEEP Kadence tabs only */
.single-product .kt-tabs-wrap {
  display: block !important;
}

/* =========================================================
   SINGLE PRODUCT — SACRED GROUND POLISH (FINAL)
   Dropdown gold-on-purple + remove meta + mobile spacing
   ========================================================= */

/* ---------- A) DROPDOWNS + INPUTS (gold on purple, readable) ---------- */
.single-product form.variations_form label {
  color: #d4af37 !important;
  letter-spacing: .02em;
}

.single-product .variations select,
.single-product .quantity input.qty {
  color: #d4af37 !important;                 /* gold text */
  background-color: #23123f !important;      /* deep purple */
  border: 1px solid rgba(212,175,55,0.45) !important;
  border-radius: 10px !important;
  padding: 10px 38px 10px 12px !important;
  min-height: 44px !important;
}

/* Make dropdown arrow visible (Chrome/Safari) */
.single-product .variations select {
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  background-image:
    linear-gradient(45deg, transparent 50%, rgba(212,175,55,0.95) 50%),
    linear-gradient(135deg, rgba(212,175,55,0.95) 50%, transparent 50%),
    linear-gradient(to right, transparent, transparent);
  background-position:
    calc(100% - 20px) 50%,
    calc(100% - 14px) 50%,
    100% 0;
  background-size:
    6px 6px,
    6px 6px,
    2.5em 2.5em;
  background-repeat: no-repeat;
}

/* Dropdown list itself (options) should be readable */
.single-product .variations select option {
  color: #111 !important;
  background: #fff !important;
}

/* Quantity field: make the number very visible */
.single-product .quantity input.qty {
  width: 64px !important;
  text-align: center !important;
  padding: 10px 10px !important;
  font-weight: 700 !important;
}

/* Focus state */
.single-product .variations select:focus,
.single-product .quantity input.qty:focus {
  outline: none !important;
  box-shadow: 0 0 0 2px rgba(212,175,55,0.35) !important;
}

/* ---------- B) REMOVE SKU / CATEGORY LINE ---------- */
.single-product .product_meta,
.single-product .sku_wrapper,
.single-product .posted_in,
.single-product .tagged_as {
  display: none !important;
}

/* ---------- C) VARIATION PRICE (styling) ---------- */
.single-product .woocommerce-variation-price,
.single-product .woocommerce-variation-availability {
  margin-top: 10px !important;
  color: #d4af37 !important;
}

/* FLUENT BOOKING CHECKOUT - COLOR FIX */
/* Makes the beige payment box match the white order summary */

/* The main payment container - right side beige box */
.fcal_payment_form,
.fcal_payment_wrap,
div[class*="fcal_payment"],
div[class*="fluent-booking-payment"] {
    background: #ffffff !important;
}

/* Credit card form area - the beige section */
.fcal_payment_methods,
.fcal_payment_method_stripe,
.fcal_stripe_element_wrapper,
div[class*="stripe-element"] {
    background: #ffffff !important;
}

/* Coupon section at top right */
.fcal_coupon_wrapper,
.fcal_has_coupon {
    background: #ffffff !important;
    border-color: rgba(107, 70, 193, 0.3) !important;
}

/* Order summary box - left side */
.fcal_order_review,
.fcal_checkout_items {
    background: #ffffff !important;
    border-color: rgba(107, 70, 193, 0.3) !important;
}

/* Make both boxes have matching borders */
.fcal_order_review,
.fcal_payment_wrap {
    border: 2px solid rgba(107, 70, 193, 0.3) !important;
    border-radius: 12px !important;
}

/* Fix any gray backgrounds in payment area */
#fcal_payment_form > div,
#fcal_payment_form .fcal_form_group {
    background: transparent !important;
}

/* Place Order button - keep golden */
button[type="submit"].fcal_btn,
.fcal_submit_button {
    background: linear-gradient(135deg, #d4af37 0%, #f6e05e 100%) !important;
    color: #1a0e27 !important;
}

/* Make left order summary text BLACK and readable */
.woocommerce-checkout-review-order-table,
.woocommerce-checkout-review-order-table *,
#order_review,
#order_review * {
    color: #000000 !important;
}

/* Product and Subtotal headers */
.woocommerce-checkout-review-order-table thead th {
    color: #000000 !important;
}

/* Product names and prices */
.woocommerce-checkout-review-order-table .product-name,
.woocommerce-checkout-review-order-table .product-total,
.woocommerce-checkout-review-order-table td,
.woocommerce-checkout-review-order-table th {
    color: #000000 !important;
}

/* Total row */
.order-total .woocommerce-Price-amount {
    color: #000000 !important;
}

/* FLUENT BOOKING - FIX THE BEIGE PAYMENT BOX */

/* Target the entire right column payment area */
div[class*="payment"],
div[id*="payment"],
.woocommerce-checkout #payment,
#payment,
#payment *,
#payment div,
#payment form {
    background-color: #ffffff !important;
    background: #ffffff !important;
}

/* The coupon box at top */
.woocommerce-form-coupon-toggle,
.checkout_coupon,
div[class*="coupon"] {
    background-color: #ffffff !important;
    background: #ffffff !important;
}

/* Credit card form area - the beige section */
.woocommerce-checkout .wc_payment_method,
.payment_box,
.payment_method_stripe,
div[class*="stripe"],
iframe[name*="stripe"] {
    background-color: #ffffff !important;
    background: #ffffff !important;
}

/* Force white background on ANY div in the payment area */
#order_review_heading ~ div,
#order_review_heading ~ * {
    background-color: #ffffff !important;
}

/* The wrapper around payment methods */
.wc_payment_methods {
    background-color: #ffffff !important;
}

/* Make text in payment area dark/readable */
#payment, #payment * {
    color: #333333 !important;
}

/* Keep Place Order button golden */
#place_order {
    background: linear-gradient(135deg, #d4af37 0%, #f6e05e 100%) !important;
    color: #1a0e27 !important;
}

/* Make left side form labels WHITE and readable */
.woocommerce-checkout .form-row label,
.woocommerce-billing-fields label,
.woocommerce-checkout label {
    color: #ffffff !important;
}

/* The asterisk (required field marker) */
.woocommerce-checkout label .required {
    color: #ff6b6b !important;
}

/* Make sure billing details heading is white */
.woocommerce-billing-fields h3 {
    color: #ffffff !important;
}

/* Light polish for Classic Cart — SAFE */
body.woocommerce-cart .woocommerce {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 20px;
}

body.woocommerce-cart .cart-collaterals {
  background: rgba(255,255,255,0.03);
  padding: 20px;
  border-radius: 12px;
}

/* Sticky header offset — Cart + Checkout only */
body.woocommerce-cart .site-content,
body.woocommerce-checkout .site-content,
body.woocommerce-cart main,
body.woocommerce-checkout main {
  padding-top: 44px !important;
}

@media (max-width: 768px) {
  body.woocommerce-cart .site-content,
  body.woocommerce-checkout .site-content,
  body.woocommerce-cart main,
  body.woocommerce-checkout main {
    padding-top: 56px !important;
  }
}

/* Hide Book a Session button on Cart + Checkout (reduce exits) */
body.woocommerce-cart .fb-floating-button,
body.woocommerce-checkout .fb-floating-button,
body.woocommerce-cart .book-a-session,
body.woocommerce-checkout .book-a-session,
body.woocommerce-cart .fluent-booking-floating,
body.woocommerce-checkout .fluent-booking-floating {
  display: none !important;
}

/* ================================
   CHECKOUT — FORCE WHITE TEXT
   Page: /checkout/
   ================================ */

body.woocommerce-checkout,
body.woocommerce-checkout p,
body.woocommerce-checkout label,
body.woocommerce-checkout span,
body.woocommerce-checkout div,
body.woocommerce-checkout h1,
body.woocommerce-checkout h2,
body.woocommerce-checkout h3,
body.woocommerce-checkout h4,
body.woocommerce-checkout h5,
body.woocommerce-checkout h6 {
  color: #ffffff !important;
}

/* Inputs & placeholders */
body.woocommerce-checkout input,
body.woocommerce-checkout select,
body.woocommerce-checkout textarea {
  color: #111 !important;
  background-color: #ffffff !important;
}

/* Placeholder text */
body.woocommerce-checkout ::placeholder {
  color: #666 !important;
}

/* Order summary box */
body.woocommerce-checkout .wc-block-components-order-summary,
body.woocommerce-checkout .wc-block-components-order-summary * {
  color: #ffffff !important;
}

/* Links */
body.woocommerce-checkout a {
  color: #ffffff !important;
  text-decoration: underline;
}

/* =========================================
   CHECKOUT VISIBILITY FIX — SACRED GROUND
   Page: /checkout/
   Purpose: Force readable white text + black CTAs
   ========================================= */

/* 1. Force all checkout text to white */
body.woocommerce-checkout,
body.woocommerce-checkout *:not(input):not(textarea):not(select) {
  color: #ffffff !important;
}

/* 2. Headings */
body.woocommerce-checkout h1,
body.woocommerce-checkout h2,
body.woocommerce-checkout h3,
body.woocommerce-checkout h4 {
  color: #ffffff !important;
}

/* 3. Coupon bar — black background, white text */
body.woocommerce-checkout .woocommerce-form-coupon-toggle,
body.woocommerce-checkout .woocommerce-info {
  background: #000000 !important;
  color: #ffffff !important;
  border: none !important;
}

body.woocommerce-checkout .woocommerce-info a {
  color: #ffffff !important;
  text-decoration: underline;
}

/* 4. Order summary text */
body.woocommerce-checkout .woocommerce-checkout-review-order,
body.woocommerce-checkout .woocommerce-checkout-review-order * {
  color: #ffffff !important;
}

/* 5. Input fields — keep readable */
body.woocommerce-checkout input,
body.woocommerce-checkout textarea,
body.woocommerce-checkout select {
  background: #ffffff !important;
  color: #111111 !important;
  border: none;
}

/* 6. Place Order button — BLACK */
body.woocommerce-checkout #place_order {
  background: #000000 !important;
  color: #ffffff !important;
  border-radius: 6px;
  font-weight: 600;
  border: none;
}

body.woocommerce-checkout #place_order:hover {
  background: #222222 !important;
}

/* 7. Payment labels & totals */
body.woocommerce-checkout .payment_method_title,
body.woocommerce-checkout .order-total,
body.woocommerce-checkout .cart-subtotal {
  color: #ffffff !important;
}

/* =========================================
   CHECKOUT (Woo Blocks) — Dark Luxe Coupon + Totals
   Keeps coupons ON.
   ========================================= */

/* 1) Order summary container */
body.woocommerce-checkout .wc-block-components-order-summary {
  background: rgba(0,0,0,0.22) !important;
  border: 1px solid rgba(255,255,255,0.10) !important;
  border-radius: 16px !important;
  padding: 22px !important;
}

/* 2) Make all text in summary readable */
body.woocommerce-checkout .wc-block-components-order-summary,
body.woocommerce-checkout .wc-block-components-order-summary * {
  color: #fff !important;
}

/* 3) THE “WHITE STRIPE” = coupon totals row (keep it, style it) */
body.woocommerce-checkout .wc-block-components-totals-coupon,
body.woocommerce-checkout .wc-block-components-totals-coupon__content,
body.woocommerce-checkout .wc-block-components-totals-item {
  background: rgba(0,0,0,0.55) !important;
  border: 1px solid rgba(255,255,255,0.10) !important;
  border-radius: 12px !important;
}

/* 4) Coupon prompt + link color */
body.woocommerce-checkout .wc-block-components-totals-coupon__label,
body.woocommerce-checkout .wc-block-components-totals-coupon a {
  color: #fff !important;
}

/* 5) When coupon expands: input + button */
body.woocommerce-checkout .wc-block-components-totals-coupon input,
body.woocommerce-checkout .wc-block-components-totals-coupon .wc-block-components-text-input input {
  background: rgba(255,255,255,0.08) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
}

body.woocommerce-checkout .wc-block-components-totals-coupon button,
body.woocommerce-checkout .wc-block-components-totals-coupon .wc-block-components-button {
  background: #000 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,0.18) !important;
}

/* 6) Totals labels + values */
body.woocommerce-checkout .wc-block-components-totals-item__label,
body.woocommerce-checkout .wc-block-components-totals-item__value,
body.woocommerce-checkout .wc-block-components-totals-footer-item__label,
body.woocommerce-checkout .wc-block-components-totals-footer-item__value {
  color: #fff !important;
}

/* 7) Kill light dividers inside the summary */
body.woocommerce-checkout .wc-block-components-order-summary hr,
body.woocommerce-checkout .wc-block-components-divider {
  border-color: rgba(255,255,255,0.10) !important;
}

/* CHECKOUT TEXT COLOR FIX */
.woocommerce-checkout-review-order,
.woocommerce-checkout-review-order * {
    color: #ffffff !important;
}

/* Make total amount stand out */
.woocommerce-checkout-review-order .order-total td,
.woocommerce-checkout-review-order .order-total th {
    color: #ffffff !important;
    font-weight: 700;
}

/* Fix subtotal, shipping, tax rows */
.woocommerce-checkout-review-order table th,
.woocommerce-checkout-review-order table td {
    color: #ffffff !important;
}

/* CART — make the right totals panel darker + readable */
body.woocommerce-cart .cart_totals,
body.woocommerce-cart .cart-collaterals .cart_totals,
body.woocommerce-cart .cart_totals .shop_table,
body.woocommerce-cart .cart_totals .wc-proceed-to-checkout {
  background: rgba(0,0,0,0.55) !important;
  border-radius: 14px !important;
  padding: 18px !important;
}

/* CART — force totals text to white */
body.woocommerce-cart .cart_totals,
body.woocommerce-cart .cart_totals * {
  color: #fff !important;
}

/* CART — specifically fix the Total row + amount */
body.woocommerce-cart .cart_totals .order-total th,
body.woocommerce-cart .cart_totals .order-total td,
body.woocommerce-cart .cart_totals .order-total .amount {
  color: #fff !important;
  font-weight: 800 !important;
}

/* CART — product row text (optional but usually needed) */
body.woocommerce-cart .woocommerce-cart-form,
body.woocommerce-cart .woocommerce-cart-form * {
  color: #fff !important;
}

body.woocommerce-cart .woocommerce-cart-form a {
  color: #fff !important;
  text-decoration: underline;
}

/* CART — coupon input text so you can see what you type */
body.woocommerce-cart #coupon_code,
body.woocommerce-cart input#coupon_code {
  color: #111 !important;
  background: #fff !important;
}

/* CART — make quantity number visible */
body.woocommerce-cart input.qty {
  color: #111 !important;        /* dark number */
  background: #ffffff !important; /* white box */
  border: 1px solid #ccc !important;
}

/* CART — fix the + / – buttons if theme styles them */
body.woocommerce-cart .quantity .minus,
body.woocommerce-cart .quantity .plus {
  color: #111 !important;
  background: #f2f2f2 !important;
  border: 1px solid #ccc !important;
}

/* =========================================================
   CHECKOUT READABILITY FIX — Sacred Ground (Woo Blocks)
   - Makes all input text readable (black text on white fields)
   - Fixes coupon field text visibility
   - Makes cart/count bubbles black with white text
   ========================================================= */

/* 1) All checkout form inputs/selects/textarea: black text + white background */
body.woocommerce-checkout .wc-block-components-text-input input,
body.woocommerce-checkout .wc-block-components-text-input textarea,
body.woocommerce-checkout .wc-block-components-select select,
body.woocommerce-checkout input[type="text"],
body.woocommerce-checkout input[type="email"],
body.woocommerce-checkout input[type="tel"],
body.woocommerce-checkout input[type="search"],
body.woocommerce-checkout input[type="number"],
body.woocommerce-checkout input[type="password"],
body.woocommerce-checkout textarea,
body.woocommerce-checkout select {
  background: #ffffff !important;
  color: #111111 !important;
  -webkit-text-fill-color: #111111 !important; /* fixes “white text” on Safari/Chrome */
  caret-color: #111111 !important;
}

/* Placeholder text slightly lighter, still readable */
body.woocommerce-checkout ::placeholder {
  color: #6b7280 !important;
  opacity: 1 !important;
}

/* 2) Labels + helper text readable on your purple background */
body.woocommerce-checkout .wc-block-components-text-input label,
body.woocommerce-checkout .wc-block-components-select label,
body.woocommerce-checkout .wc-block-components-checkout-step__title,
body.woocommerce-checkout .wc-block-components-title,
body.woocommerce-checkout .wc-block-components-checkout-step__description,
body.woocommerce-checkout .wc-block-components-validation-error,
body.woocommerce-checkout .wc-block-components-notice-banner__content {
  color: #ffffff !important;
}

/* 3) Coupon field: make sure input + typed code is visible */
body.woocommerce-checkout .wc-block-components-totals-coupon-link,
body.woocommerce-checkout .wc-block-components-totals-coupon__form input,
body.woocommerce-checkout .wc-block-components-totals-coupon__form input[type="text"] {
  background: #ffffff !important;
  color: #111111 !important;
  -webkit-text-fill-color: #111111 !important;
}

/* Coupon apply button readable */
body.woocommerce-checkout .wc-block-components-totals-coupon__form button,
body.woocommerce-checkout .wc-block-components-totals-coupon__form .wc-block-components-button {
  color: #111111 !important;
}

/* 4) Cart count “bubble” in header: black circle + white number */
.site-header .cart-count,
.site-header .cart-contents .count,
.site-header .menu-cart-count,
.site-header .kadence-header-cart .count,
.site-header .kadence-header-cart .cart-count,
.site-header .wc-block-mini-cart__badge,
.site-header .wp-block-woocommerce-mini-cart__badge {
  background: #000000 !important;
  color: #ffffff !important;
  border: 1px solid #000000 !important;
}

/* 5) Any small quantity/count pills inside order summary */
body.woocommerce-checkout .wc-block-components-quantity-badge,
body.woocommerce-checkout .wc-block-components-product-badge,
body.woocommerce-checkout .wc-block-components-order-summary-item__quantity {
  background: #000000 !important;
  color: #ffffff !important;
  border-color: #000000 !important;
}

/* Header cart count bubble */
.site-header .wc-block-mini-cart__badge,
.site-header .wp-block-woocommerce-mini-cart__badge,
.site-header .kadence-header-cart .count,
.site-header .kadence-header-cart .cart-count,
.site-header .kadence-header-cart .kadence-cart-count {
  background: #000 !important;
  color: #fff !important;
  border: 2px solid #000 !important;
}

/* Coupon container */
body.woocommerce-checkout .wc-block-components-totals-coupon {
  border-radius: 16px !important;
  overflow: hidden !important;
  background: rgba(255,255,255,0.06) !important;
  border: 1px solid rgba(255,255,255,0.15) !important;
}

/* "Add coupons" toggle bar */
body.woocommerce-checkout .wc-block-components-panel__button {
  background: rgba(0,0,0,0.45) !important;
  color: #fff !important;
  padding: 14px 16px !important;
  border-radius: 16px 16px 0 0 !important;
  font-weight: 600 !important;
}

/* Coupon input row */
body.woocommerce-checkout .wc-block-components-panel__content {
  padding: 14px !important;
  background: transparent !important;
}

/* Coupon text field */
body.woocommerce-checkout .wc-block-components-totals-coupon input[type="text"] {
  background: #fff !important;
  color: #111 !important;
  border-radius: 10px !important;
  border: 1px solid #ccc !important;
  -webkit-text-fill-color: #111 !important;
}

/* Apply button */
body.woocommerce-checkout .wc-block-components-totals-coupon button {
  background: #000 !important;
  color: #fff !important;
  border-radius: 10px !important;
  border: none !important;
  font-weight: 600 !important;
}

/* Checkout form fields readable */
body.woocommerce-checkout input,
body.woocommerce-checkout select,
body.woocommerce-checkout textarea {
  background: #fff !important;
  color: #111 !important;
  border: 1px solid #ccc !important;
  border-radius: 8px !important;
  -webkit-text-fill-color: #111 !important;
}

/* Placeholder text */
body.woocommerce-checkout input::placeholder,
body.woocommerce-checkout textarea::placeholder {
  color: #666 !important;
}

/* Payment method box styling */
body.woocommerce-checkout .wc-block-checkout__payment-method {
  background: rgba(255,255,255,0.08) !important;
  border-radius: 16px !important;
  border: 1px solid rgba(255,255,255,0.15) !important;
  padding: 16px !important;
}

body.woocommerce-checkout .wc-block-components-checkout-place-order-block button {
  background: linear-gradient(135deg, #d4af37, #f6e05e) !important;
  color: #1a0e27 !important;
  font-weight: 700 !important;
  border-radius: 10px !important;
  padding: 14px 24px !important;
  border: none !important;
}

/* ===== CART COUNT BUBBLE (HEADER) FIX ===== */

.site-header .cart-contents .count,
.header-cart .count,
a.cart-contents .count,
.woocommerce .cart-contents .count {
  background: #d4af37 !important; /* Sacred Ground gold */
  color: #1a0e27 !important;      /* deep cosmic purple text */
  border: 2px solid #1a0e27 !important;
  font-weight: 700 !important;
  box-shadow: 0 0 0 2px rgba(0,0,0,0.15) !important;
}

/* Slightly larger so it’s readable */
.site-header .cart-contents .count {
  min-width: 20px;
  min-height: 20px;
  line-height: 18px;
  font-size: 12px;
  padding: 0 5px;
  border-radius: 999px;
}

/* Checkout & Cart — Apply Coupon button text readable */
.woocommerce-cart .coupon button,
.woocommerce-checkout .wc-block-components-totals-coupon button {
  color: #000 !important;
  font-weight: 600;
}

/* Cart — Update Cart button text readable */
.woocommerce-cart button[name="update_cart"] {
  color: #000 !important;
  font-weight: 600;
}

/* Cart & Checkout — Coupon code input text readable */
.woocommerce-cart .coupon input.input-text,
.woocommerce-checkout .wc-block-components-totals-coupon input {
  color: #000 !important;
}

/* Checkout — Coupon accordion header (fix ugly gray bar) */
.woocommerce-checkout .wc-block-components-panel__button {
  background: linear-gradient(180deg, rgba(26, 14, 39, 0.95) 0%, rgba(74, 25, 66, 0.9) 100%) !important;
  color: #fff !important;
  border: 1px solid rgba(107, 70, 193, 0.45) !important;
  border-radius: 12px !important;
}

/* Checkout — Coupon input and Apply button readable */
.woocommerce-checkout .wc-block-components-totals-coupon input {
  color: #000 !important;
}

.woocommerce-checkout .wc-block-components-totals-coupon button {
  color: #000 !important;
  font-weight: 600;
}

/* TEC Month View — Make weekday letters bigger + brighter gold */

body .tribe-events-view--month .tribe-events-calendar-month__weekday,
body .tribe-events-view--month .tribe-events-calendar-month__header-column-title,
body .tribe-events-view--month .tribe-events-calendar-month__header-column,
body .tribe-events-view--month .tribe-events-calendar-month__weekdays *,
body .tribe-events-view--month th[scope="col"] {
