    padding-top: 160px !important;
}
/* STICKY NAV FIX — Kadence overflow:clip on #wrapper breaks position:sticky on header.
   Kadence global.min.css sets #wrapper { overflow-x: clip } which creates a new
   containing block and prevents sticky headers from working despite the Kadence
   sticky header setting being enabled. This one override restores correct behavior.
   Do not remove. Added 2026-06-11. */
#wrapper { overflow-x: visible !important; }

#wrapper { overflow-x: visible !important; }

/* Observatory launch period
   Hide pricing and membership messaging
   Restore after August 1 if desired */
.sgobs-hero-sub { display: none !important; }
.sgobs-instruments-sub { display: none !important; }


/* Beneath the Noise — readable sans-serif (added by request) */
.eeo-prose{font-family:Roboto,"Helvetica Neue",Helvetica,Arial,sans-serif !important;font-style:normal !important;font-weight:500 !important;}


/* Tarot card title — match other titles */
.eeo-tarot-card-name{font-size:30px !important;line-height:1.25 !important;}


/* Beneath the Noise lede + feature titles consistent */
.sgobs-note--atmos .eeo-lede{font-family:Roboto,"Helvetica Neue",Helvetica,Arial,sans-serif !important;font-style:normal !important;font-weight:500 !important;}
.eeo-entry__title{font-size:30px !important;line-height:1.25 !important;}

/* ============================================================ */
/* PAGE OVERRIDE - Practitioners & Modalities (page-id-17216). Added 2026-07-25 by Claude, requested by Deneene. Background reverted to the ORIGINAL dark plum gradient (the earlier lilac page-wash override has been removed). This block instead gives the section headings ("Our Practitioners", "Modalities") a warm-to-cool gradient text treatment matching the "Sacred Ground" wordmark gradient (gold -> coral -> purple -> blue-violet). Scope: body.page-id-17216 ONLY. TO REVERT: delete this block. */
body.page-id-17216 .sg-pm__title {
  background: linear-gradient(90deg, #f2a93c 0%, #e8825f 30%, #c96a94 55%, #8b6fc0 80%, #6f7fd6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent !important;
}
/* END PAGE OVERRIDE (Practitioners & Modalities gradient headings) */

/* ============================================================ */
/* PAGE OVERRIDE - Practitioners & Modalities (page-id-17216). Added 2026-07-25 by Claude, requested by Deneene. Visible glow around the rotating gold/blue rings on each practitioner photo. Previous pass used a wide box-shadow that bloomed too far and washed out the name pills/text below - this version drops the box-shadow and uses a tighter, layered drop-shadow so the glow stays hugging the ring itself. Scope: body.page-id-17216 ONLY. TO REVERT: delete this block. */
body.page-id-17216 .sg-portrait::before,
body.page-id-17216 .sg-portrait::after {
  border-width: 2px !important;
}
body.page-id-17216 .sg-portrait::before {
  filter: drop-shadow(0 0 4px #fff3d6) drop-shadow(0 0 10px var(--gold-bright)) drop-shadow(0 0 18px var(--gold));
}
body.page-id-17216 .sg-portrait::after {
  filter: drop-shadow(0 0 4px #d8f0fb) drop-shadow(0 0 10px #9ecbe8) drop-shadow(0 0 18px var(--sky));
}
/* END PAGE OVERRIDE (Practitioners & Modalities photo ring glow) */

