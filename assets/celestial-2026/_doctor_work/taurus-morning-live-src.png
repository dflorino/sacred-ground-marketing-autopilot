<link rel="https://api.w.org/" href="https://shopsacredground.com/wp-json/" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://shopsacredground.com/xmlrpc.php?rsd" />
<meta name="generator" content="WordPress 7.0.3" />
<!-- start Simple Custom CSS and JS -->
<style>
.sg-sound-row__action { display: none !important; }

.sg-lib-hero:has(img[src*="6f2feffe-f733-4b4f-b8ea-1886f584a7e9"]) {
  background: url('https://shopsacredground.com/wp-content/uploads/6f2feffe-f733-4b4f-b8ea-1886f584a7e9.png') center/cover no-repeat;
  aspect-ratio: 3 / 2;
}
.sg-lib-hero:has(img[src*="6f2feffe-f733-4b4f-b8ea-1886f584a7e9"]) img {
  display: none;
}

.sg-sound-row__action.sg-view-visible {
  display: inline-flex !important;
}

/* Fix: nav dropdown submenus (Library, Calendar, Observatory, Holistic Center)
   rendering behind the sticky header / announcement banner instead of above page content */
header.site-header,
.site-header-wrap.child-is-fixed,
.site-header-inner-wrap.kadence-sticky-header {
  z-index: 99999 !important;
}
#site-navigation .sub-menu {
  z-index: 99999 !important;
}

/* All Playlists page: hide rows filtered out by category chip */
.sg-sound-row[hidden] {
  display: none !important;
}

/* Playlist detail template (Purpose / Best for / Duration / Ordered Track List / Copy) */
.sg-playlist-detail {
  margin: 1.5rem 0;
}
.sg-playlist-detail__row {
  margin-bottom: 0.9rem;
}
.sg-playlist-detail__label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #d4af37;
  margin-bottom: 0.2rem;
}
.sg-playlist-detail__text {
  color: rgba(247, 250, 252, 0.85);
  font-size: 1rem;
  line-height: 1.5;
}
.sg-playlist-tracks {
  list-style: decimal;
  margin: 0.5rem 0 1.5rem;
  padding-left: 1.4rem;
  color: #FFFFFF;
}
.sg-playlist-tracks li {
  padding: 0.4rem 0;
  border-bottom: 1px solid rgba(247, 250, 252, 0.08);
}
.sg-playlist-fallback {
  display: block;
  width: 100%;
  min-height: 120px;
  margin-top: 0.75rem;
  padding: 0.75rem;
  background: rgba(0, 0, 0, 0.35);
  border: 1px solid rgba(212, 175, 55, 0.4);
  border-radius: 8px;
  color: #FFFFFF;
  font-family: monospace;
  font-size: 0.85rem;
  box-sizing: border-box;
}

.sg-playlist-fallback[hidden] {
  display: none !important;
}</style>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (!document.body.classList.contains('single-sg_sound_playlist')) {
    return;
  }

  var header = document.querySelector('.sg-sound-single__header');
  var metaRow = document.querySelector('.sg-sound-single__meta-row');
  if (!header) {
    return;
  }

  var idMatch = document.body.className.match(/postid-(\d+)/);
  var postId = idMatch ? idMatch[1] : null;
  if (!postId) {
    return;
  }

  fetch('/wp-json/wp/v2/sg_sound_playlist/' + postId + '?_fields=meta')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var meta = data.meta || {};
      var purpose = meta._sg_sound_intention || '';
      var bestFor = meta._sg_sound_mood || '';
      var duration = meta._sg_sound_duration || '';
      var trackListRaw = meta._sg_sound_playlist_artists || '';
      var lines = trackListRaw.split('\n').map(function (l) { return l.trim(); }).filter(Boolean);

      var looksLikeLegacyIds = lines.length === 1 && /^[0-9,\s]+$/.test(lines[0]);
      if (looksLikeLegacyIds || !lines.length) {
        return;
      }

      if (metaRow) {
        metaRow.style.display = 'none';
      }

      var wrap = document.createElement('div');
      wrap.className = 'sg-playlist-detail';

      var metaHtml = '';
      if (purpose) {
        metaHtml += '<div class="sg-playlist-detail__row"><span class="sg-playlist-detail__label">Purpose</span><span class="sg-playlist-detail__text">' + purpose + '</span></div>';
      }
      if (bestFor) {
        metaHtml += '<div class="sg-playlist-detail__row"><span class="sg-playlist-detail__label">Best for</span><span class="sg-playlist-detail__text">' + bestFor + '</span></div>';
      }
      if (duration) {
        metaHtml += '<div class="sg-playlist-detail__row"><span class="sg-playlist-detail__label">Approximate duration</span><span class="sg-playlist-detail__text">' + duration + '</span></div>';
      }

      var tracksHtml = '<h3 class="sg-sound-type-heading">Ordered Track List</h3><ol class="sg-playlist-tracks">' +
        lines.map(function (l) { return '<li>' + l + '</li>'; }).join('') +
        '</ol>';

      var copyText = lines.join('\n');
      var copyHtml = '<div class="sg-sound-copy-actions">' +
        '<button type="button" class="sg-sound-copy-btn sg-playlist-copy-btn">Copy Playlist</button>' +
        '</div>' +
        '<textarea class="sg-playlist-fallback" readonly hidden></textarea>' +
        '<p class="sg-sound-copy-note">This gives you a clean, ordered list to search and add in Spotify, Apple Music, YouTube Music, or wherever you listen &mdash; it does not create an automatic playlist for you.</p>';

      wrap.innerHTML = metaHtml + tracksHtml + copyHtml;
      header.insertAdjacentElement('afterend', wrap);

      var copyBtn = wrap.querySelector('.sg-playlist-copy-btn');
      var fallback = wrap.querySelector('.sg-playlist-fallback');

      function showFallback() {
        fallback.value = copyText;
        fallback.hidden = false;
        fallback.focus();
        fallback.select();
      }

      function showCopied() {
        copyBtn.textContent = 'Copied';
        copyBtn.classList.add('sg-sound-copy-btn--copied');
        setTimeout(function () {
          copyBtn.textContent = 'Copy Playlist';
          copyBtn.classList.remove('sg-sound-copy-btn--copied');
        }, 2000);
      }

      copyBtn.addEventListener('click', function () {
        var settled = false;

        function settle(success) {
          if (settled) {
            return;
          }
          settled = true;
          if (success) {
            showCopied();
          } else {
            showFallback();
          }
        }

        setTimeout(function () { settle(false); }, 1500);

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(copyText).then(function () {
            settle(true);
          }).catch(function () {
            settle(false);
          });
        } else {
          settle(false);
        }
      });
    })
    .catch(function () {});
});</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  var API = '/wp-json/wp/v2/';

  // Part 1: inject an "All Playlists" tile into the Sacred Sounds hub category grid
  var grid = document.querySelector('.sg-sound-cat-grid');
  if (grid && !grid.querySelector('.sg-all-playlists-tile')) {
    var card = document.createElement('div');
    card.className = 'sg-sound-cat-card sg-all-playlists-tile';
    card.innerHTML = '<a class="sg-sound-cat-card__link" href="https://shopsacredground.com/library-sacred-sounds-playlists/"><span class="sg-sound-cat-card__title">All Playlists</span></a>';
    grid.appendChild(card);
  }

  // Part 2: build the filterable All Playlists list
  var listEl = document.getElementById('sg-playlists-list');
  var filtersEl = document.getElementById('sg-playlists-filters');
  if (!listEl || !filtersEl) {
    return;
  }

  Promise.all([
    fetch(API + 'sg_sound_category?per_page=100&_fields=id,name,slug,parent').then(function (r) { return r.json(); }),
    fetch(API + 'sg_sound_playlist?per_page=100&_fields=id,title,link,excerpt,sg_sound_category').then(function (r) { return r.json(); })
  ]).then(function (results) {
    var terms = results[0];
    var playlists = results[1];

    var termMap = {};
    terms.forEach(function (t) { termMap[t.id] = t; });

    function topAncestor(termId) {
      var t = termMap[termId];
      var guard = 0;
      while (t && t.parent && t.parent !== 0 && guard < 10) {
        t = termMap[t.parent];
        guard++;
      }
      return t || null;
    }

    var byCategory = {};
    playlists.forEach(function (p) {
      var catId = (p.sg_sound_category && p.sg_sound_category[0]) || null;
      var top = catId ? topAncestor(catId) : null;
      var slug = top ? top.slug : 'uncategorized';
      var name = top ? top.name : 'Uncategorized';
      if (!byCategory[slug]) {
        byCategory[slug] = { name: name, items: [] };
      }
      byCategory[slug].items.push(p);
    });

    var catSlugs = Object.keys(byCategory).sort(function (a, b) {
      return byCategory[a].name.localeCompare(byCategory[b].name);
    });

    var chipsHtml = '<button type="button" class="sg-lib-chip is-active" data-filter="all">All (' + playlists.length + ')</button>';
    catSlugs.forEach(function (slug) {
      chipsHtml += '<button type="button" class="sg-lib-chip" data-filter="' + slug + '">' + byCategory[slug].name + ' (' + byCategory[slug].items.length + ')</button>';
    });
    filtersEl.innerHTML = chipsHtml;

    var allItems = [];
    catSlugs.forEach(function (slug) {
      var items = byCategory[slug].items.slice().sort(function (a, b) {
        return a.title.rendered.localeCompare(b.title.rendered);
      });
      items.forEach(function (p) { allItems.push({ p: p, slug: slug }); });
    });

    if (!allItems.length) {
      listEl.innerHTML = '<li class="sg-sound-meta">No playlists found yet.</li>';
      return;
    }

    var rowsHtml = allItems.map(function (entry) {
      var p = entry.p;
      var excerptText = p.excerpt && p.excerpt.rendered ? p.excerpt.rendered.replace(/<[^>]+>/g, '').trim() : '';
      return '<li class="sg-sound-row" data-category="' + entry.slug + '">' +
        '<span class="sg-sound-row__info">' +
        '<span class="sg-sound-row__badge">Playlist</span>' +
        '<span class="sg-sound-row__title">' + p.title.rendered + '</span>' +
        (excerptText ? '<span class="sg-sound-row__desc">' + excerptText + '</span>' : '') +
        '</span>' +
        '<a class="sg-sound-row__action sg-view-visible" href="' + p.link + '">View &rarr;</a>' +
        '</li>';
    }).join('');
    listEl.innerHTML = rowsHtml;

    filtersEl.addEventListener('click', function (e) {
      var btn = e.target.closest('.sg-lib-chip');
      if (!btn) {
        return;
      }
      filtersEl.querySelectorAll('.sg-lib-chip').forEach(function (c) { c.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var filter = btn.getAttribute('data-filter');
      listEl.querySelectorAll('.sg-sound-row').forEach(function (row) {
        if (filter === 'all' || row.getAttribute('data-category') === filter) {
          row.removeAttribute('hidden');
        } else {
          row.setAttribute('hidden', '');
        }
      });
    });
  }).catch(function () {
    listEl.innerHTML = '<li class="sg-sound-meta">Could not load playlists right now.</li>';
  });
});</script>
<!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('h3.sg-sound-type-heading').forEach(function (h3) {
    if (h3.textContent.trim() === 'Playlists') {
      var ul = h3.nextElementSibling;
      if (ul && ul.classList.contains('sg-sound-list')) {
        ul.querySelectorAll('.sg-sound-row__action').forEach(function (a) {
          a.classList.add('sg-view-visible');
        });
      }
    }
  });
});</script>
<!-- end Simple Custom CSS and JS -->
