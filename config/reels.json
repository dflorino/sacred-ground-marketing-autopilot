{
  "stack": "heygen",
  "status": "scaffolded_ig_fb_reels_daily_not_auto_yet",
  "timezone": "America/Chicago",
  "avatar": {
    "provider": "heygen",
    "role": "face_and_lip_sync",
    "notes": "Digital Twin / Presenter from assets/deneene-refs. Never Cursor stills."
  },
  "voice": {
    "provider": "heygen",
    "mode": "voice_clone",
    "clone_source": "fish_heygen_clone",
    "samples_dir": "assets/deneene-voice",
    "status": "working_per_founder",
    "fallback_note": "ElevenLabs only if HeyGen/Fish clone is insufficient later"
  },
  "backgrounds": {
    "dir": "assets/heygen/backgrounds",
    "exterior_canonical": "assets/heygen/sg-store-background.jpg",
    "shoot_priority": ["crystal_cases", "aisles", "logo_wall", "books_incense", "open_floor"],
    "aspect": "prefer_portrait_9_16_for_shorts"
  },
  "scripts": {
    "batch_markdown": "data/reels/scripts-batch-01.md",
    "batch_json": "config/reel_scripts.json",
    "first_recommended": "welcome"
  },
  "heygen": {
    "api_base": "https://api.heygen.com",
    "create_video_path": "/v3/videos",
    "list_avatars_path": "/v3/avatars",
    "list_voices_path": "/v3/voices",
    "env": {
      "api_key": "HEYGEN_API_KEY",
      "avatar_id": "HEYGEN_AVATAR_ID",
      "voice_id": "HEYGEN_VOICE_ID",
      "background_asset_id": "HEYGEN_BACKGROUND_ASSET_ID"
    },
    "avatar_id": null,
    "voice_id": null,
    "background_asset_id": null,
    "default_aspect_ratio": "9:16",
    "default_resolution": "1080p",
    "dry_run_script": "scripts/heygen_dry_run.py",
    "notes": "IDs stay null in git — set via env. Do not commit API keys."
  },
  "content": {
    "sources": [
      "reel_scripts_batch",
      "observatory_beneath_surface"
    ],
    "rotation": "welcome_batch_then_beneath_surface",
    "wp_option_pattern": "eeo_daily_YYYY-MM-DD",
    "field": "beneath_surface",
    "day": "yesterday",
    "target_duration_seconds": [15, 30],
    "caption_link": "https://shopsacredground.com/sacred-ground-observatory/",
    "shop_link": "https://shopsacredground.com/"
  },
  "looks": {
    "config": "config/deneene_looks.json",
    "rotate": true,
    "include_outdoor_sunglasses": true
  },
  "publish": {
    "phase": 1,
    "campaign": "daily_reel",
    "approve_before_post": true,
    "auto_publish": false,
    "schedule_local_time": "10:30",
    "format": "9:16",
    "media_type": "video",
    "platforms_primary": ["instagram_reels", "facebook_reels"],
    "platforms_optional_later": ["tiktok", "youtube_shorts"],
    "platforms": ["instagram_reels", "facebook_reels"],
    "zernio_account_map": {
      "instagram_reels": "instagram",
      "facebook_reels": "facebook",
      "note": "Same FB/IG account IDs in config/accounts.json once video/Reels publish is supported"
    },
    "works_today": "FB+IG still-image posts via Zernio (today / week_ahead / tuesday_meditation)",
    "not_ready": "HeyGen generate → public video URL → Zernio/ML Social or Meta Reels API with type=video",
    "note": "Daily IG+FB Reels are the Founder target. Do not silent-publish video until the video path is verified. TikTok/YouTube Shorts optional later."
  },
  "isolation": {
    "does_not_touch": [
      "marketing publish-today",
      "marketing publish-week-ahead",
      "marketing publish-tuesday-meditation",
      "ZERNIO_API_KEY morning/evening/tuesday image path"
    ]
  },
  "founder_still_needed": [
    "Interior/case background photos → assets/heygen/backgrounds/",
    "Optional: HEYGEN_API_KEY + HEYGEN_AVATAR_ID + HEYGEN_VOICE_ID in .env for API generate",
    "Approve first draft reel before any public IG/FB Reels post",
    "Confirm Zernio/ML Social accepts video media for Instagram Reels + Facebook Reels (or use Meta Reels API)",
    "Host generated 9:16 MP4 at a stable HTTPS URL for Zernio mediaItems"
  ]
