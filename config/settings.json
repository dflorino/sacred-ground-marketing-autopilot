{
  "service": "sacred-ground-marketing-autopilot",
  "version": "1.0.0",
  "timezone": "America/Chicago",
  "site_url": "https://shopsacredground.com",
  "tec_events_url": "https://shopsacredground.com/wp-json/tribe/events/v1/events",
  "default_phase": 1,
  "platforms": ["facebook", "instagram"],
  "brand_images": {
    "exterior_url": "https://shopsacredground.com/wp-content/uploads/Screenshot-2026-03-05-at-9.20.15-AM.png",
    "interior_url": "https://shopsacredground.com/wp-content/uploads/CD3C3C2E-620B-4933-BC24-11ED63552132-1.png",
    "store_fallback": "exterior"
  },
  "campaigns": {
    "today": {
      "enabled": true,
      "label": "Today at Sacred Ground",
      "schedule_local_time": "07:00",
      "platforms": ["facebook", "instagram"],
      "source": "the_events_calendar",
      "auto_publish": true,
      "empty_day_fallback": true,
      "default_image_url": "https://shopsacredground.com/wp-content/uploads/Screenshot-2026-03-05-at-9.20.15-AM.png",
      "image_policy": "image_rules_library",
      "image_rules_file": "config/image_rules.json",
      "notes": "Every morning 7am CT: auto-publish Today FB+IG from live TEC (or visit/brand post if empty). Images from config/image_rules.json."
    },
    "week": {
      "enabled": true,
      "label": "This Week at Sacred Ground",
      "weekday": "monday",
      "schedule_local_time": "10:00"
    },
    "week_ahead": {
      "enabled": true,
      "label": "Next 7 Days at Sacred Ground",
      "schedule_local_time": "19:00",
      "horizon_days": 7,
      "store_image_url": "https://shopsacredground.com/wp-content/uploads/Screenshot-2026-03-05-at-9.20.15-AM.png",
      "cta_phone": "847-749-3922",
      "cta_site": "shopsacredground.com"
    },
    "spotlight": {
      "enabled": true,
      "label": "Special Event Spotlight",
      "reminder_days_before": [7, 3, 1],
      "schedule_local_time": "11:00"
    }
  },
  "special_category_names": [
    "Special Event",
    "Special Events",
    "Featured",
    "Holistic Fair",
    "Fair"
  ],
  "special_title_keywords": [
    "holistic fair",
    "psychic fair",
    "vendor fair",
    "summer holistic fair",
    "open house",
    "anniversary",
    "retreat",
    "immersion"
  ],
  "spotlight_only_special": true,
  "star_marks_featured_not_spotlight": true,
  "exclude_title_substrings": [
    "community meditation"
  ],
  "require_event_url": true,
  "max_today_events_in_caption": 6,
  "max_week_events_in_caption": 10,
  "max_week_ahead_events_in_caption": 14
}
